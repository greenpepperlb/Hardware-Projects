                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Project_Cellular_automaton.asm
                                 ; Project for Sensors and Micro-electronics
                                 ; Date : 2026
                                 ; Author : Laurent
                                 
                                 
                                 ;==================================
                                 ; Include ATmega328P definitions
                                 ;==================================
                                 .INCLUDE "m328pdef.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;======================================================
                                 ; Register definitions(.DEF) and Constants (.EQU)
                                 ;======================================================
                                 ;----ISR Exclusive registers----------------
                                 .DEF Column_index  = R2     ; timer0, active physical row currently scanned
                                 .DEF display_tempo = R3     ; timer0 temp holding for SRAM fetch
                                 .DEF beat_counter  = R6     ; timer2 software beat counter
                                 .DEF debounce_tick = R7     ; timer2 edit-cursor blink divider
                                 
                                 ;-------------Main state registers------------
                                 .DEF playhead    = R4     ; current step (0-31) being played
                                 .DEF cursor      = R5     ; edit cursor register 
                                 .DEF seed_low    = R8     ; low byte of the LFSR seed
                                 .DEF seed_high   = R9     ; high byte of the LFSR seed
                                 .DEF rule_number = R10    ; selected cellular automaton rule
                                 .DEF scale_index = R11    ; selected musical scale
                                 .DEF Octave      = R12    ; current octave shift
                                 
                                 ;-------------General-purpose working registers------------
                                 .DEF temp     = R16       ; temporary register
                                 .DEF px_x     = R20       ; pixel X coordinate for drawing
                                 .DEF px_y     = R21       ; pixel Y coordinate for drawing
                                 .DEF px_state = R22       ; pixel state (0 = off, 1 = on)
                                 ;----------------Constant definition ----------------
                                 .EQU NUM_COLS = 40
                                 .EQU NUM_ROWS = 14
                                 .EQU CA_WIDTH = 32 ;Width of the waterfall
                                 .EQU HISTORY_ROWS = 14
                                 .EQU HISTORY_BYTES = 56 ; 14 Generations of 32bits=4byte 14*4=56 bytes of memory
                                 .EQU NUM_RULES = 3 ; RULE 30(chaotic and random), 90(sierpinski triangle),
                                 ; rule 110(turing complete complex patterns)
                                 .EQU NUM_SCALES = 3 ; MAJOR, MINOR, PENTATONIC
                                 .EQU NUM_KEYS = 16
                                 .EQU MODE_RUN_BIT = 0 ; bit 0= RUN/EDIT
                                 .EQU MODE_PLAY_BIT = 1 ; bit 1 = PLAY/PAUSE
                                 .EQU MODE_BLINK_BIT = 2 ; bit 2= CURSOR BLINK
                                 .EQU MODE_MUTE_BIT  = 3    ; Bit 3 = GLOBAL MUTE
                                 .EQU TIMER0_PRESCALE = (1<<CS02) ; T0 Prescaler /256 ( CS02=1 CS01=0 CS00=0 cf datasheet)
                                 .EQU TIMER1_PRESCALE = (1<<CS11) ; T1 Prescaler /8 (CS12=0 CS11=1 CS10=1 cf datasheet)
                                 .EQU DEFAULT_BPM = 120
                                 .EQU MIN_BPM = 60
                                 .EQU MAX_BPM = 300
                                 .EQU FRAME_BYTES = 80                 ; 8 physical row holding 80pixels( 40 top +40 bottom )=10bytes 8*10= 80
                                 .EQU BYTES_PER_PHYSICAL_ROW = 10
                                 .EQU PHYSICAL_ROWS = 8
                                 .EQU VISIBLE_PHYSICAL_ROWS = 7
                                 .EQU TIMER0_OCR_VALUE = 99            ; /256 gives about 625 row scans/s
                                 .EQU INPUT_TICK_DIV = 10              ; Timer2 overflow about 1 ms, input about 10 ms
                                 .EQU BEAT_TICKS = 122                 ; about 125 ms, close to 120 BPM sixteenth notes
                                 .EQU DEFAULT_RULE = 30
                                 .EQU DEFAULT_LFSR_LOW = 0xE1          ; arbitrary cannot start at 0 and LFSR is 16 bit
                                 .EQU DEFAULT_LFSR_HIGH = 0xAC
                                 .EQU NB_NOTES = 48                    ;Octave 1 : 12 notes Octave 2 : 12 notes Octave 3 : 12 notes Octave 4 : 12 notes
                                 .EQU ADC_LOW_TH = 64                  ;ADC Thresholds, 8bit mode
                                 .EQU ADC_HIGH_TH = 192
                                 
                                 ; Pins
                                 .EQU SW_PIN = 0
                                 .EQU BUZZER_PIN = 1
                                 .EQU JS_BTN_PIN = 2
                                 .EQU DISP_DATA = 3
                                 .EQU DISP_LATCH = 4
                                 .EQU DISP_CLOCK = 5
                                 .EQU LED_LOW_PIN = 2
                                 .EQU LED_HIGH_PIN = 3
                                 .EQU KP_COL4 = 0
                                 .EQU KP_COL3 = 1
                                 .EQU KP_COL2 = 2
                                 .EQU KP_COL1 = 3
                                 
                                 ; Joystick direction codes
                                 ; Stored in prev_js_dir so actions occur only once per movement.
                                 .EQU DIR_LEFT  = 1
                                 .EQU DIR_RIGHT = 2
                                 .EQU DIR_UP    = 4
                                 .EQU DIR_DOWN  = 8
                                 
                                 ;=====================================
                                 ; SRAM VARIABLES(.DSEG)
                                 ;=====================================
                                 .DSEG
                                 .ORG SRAM_START
                                 
000100                           history_buffer    : .byte 56 ; 14 generation*32bit= 14*4
000138                           frame_buffer      : .byte 80 ; 8 rows and 80 led per rows= 8*10 byte
000188                           current_gen       : .byte 4  ; one CA generation = 32bit= 4 byte
00018c                           next_gen          : .byte 4  ;same
000190                           playhead_pos      : .byte 1
000191                           Cursor_pos        : .byte 1 ;from 0 to 31 position
000192                           bpm_value         : .byte 2 ;60 to 300 so 2 bytes
000194                           lfsr_seed         : .byte 2 ;LFSR= 16 bit 
000196                           rule_number_store : .byte 1
000197                           scale_index_store : .byte 1
000198                           octave_shift      : .byte 1
000199                           mode_flags        : .byte 1
00019a                           input_tick_flag   : .byte 1   ; Set by Timer2(~10 ms). Main loop clears after reading keypad and joystick.
00019b                           step_flag         : .byte 1   ; Set by Timer2 to advance one sequencer/CA step.
00019c                           timer2_divider    : .byte 1   ; Software counter used to divide fast Timer2 OV into slow.
00019d                           beat_tick_limit   : .byte 1   ; Number of Timer2 overflows needed before generating one sequencer step. Depends on BPM.
00019e                           key_last          : .byte 1   ; Stores the last detected keypad value to ignore held keys and detect new presses only.
00019f                           prev_js_dir       : .byte 1   ; Stores the previous joystick direction for edge detection
0001a0                           prev_js_click     : .byte 1   ; Stores the previous joystick button state to detect a new click only.
                                 ;========================================
                                 ; Interrupt adress Vectors(.CSEG)
                                 ;========================================
                                 .CSEG
                                 .ORG 0x0000
000000 c033                      RJMP Initialisation ; jump to start
                                 
                                 .ORG 0x001C ; timer 0 CTC use OCR0A cf datasheet
00001c c07d                      RJMP Timer0_ISR
                                 
                                 .ORG 0x0016 ;Timer 1 CTC use OCR1A cf datasheet
000016 c0b7                      RJMP Timer1_ISR
                                 
                                 .ORG 0x0012 ; Timer 2 OV cf datasheet 
000012 c0c3                      RJMP Timer2_ISR
                                 
                                 ;==========================================
                                 ; MAIN PROGRAM
                                 ;=========================================
                                 .ORG 0x0034 ; end of interrupt vector table 
                                 
                                 ;------------INITIALISATION----------------
                                 Initialisation:
                                 ; --- Initialize Stack Pointer ---
000034 ef0f                      LDI R16, LOW(RAMEND)
000035 bf0d                      OUT SPL, R16
000036 e008                      LDI R16, HIGH(RAMEND)
000037 bf0e                      OUT SPH, R16
                                 
000038 2411                      CLR R1
000039 94f8                      CLI
                                 
                                 ; --- Setup of pins ---
                                 ; joystick button
00003a 9822                      CBI DDRB,2
00003b 9a2a                      SBI PORTB,2
                                 
                                 ; joystick analog axes: PC0 = X, PC1 = Y
00003c 9838                      CBI DDRC,0
00003d 9839                      CBI DDRC,1
                                 
                                 ; switch
00003e 9820                      CBI DDRB,0
00003f 9a28                      SBI PORTB,0
                                 
                                 ; LED 1 and LED 2, active low
000040 9a3b                      SBI DDRC,3
000041 9a43                      SBI PORTC,3
000042 9a3a                      SBI DDRC,2
000043 9a42                      SBI PORTC,2
                                 
                                 ; buzzer
000044 9a21                      SBI DDRB,1
000045 9829                      CBI PORTB,1
                                 
                                 ; keyboard setup: rows PD7-PD4 outputs, columns PD3-PD0 inputs with pullups
000046 ef00                      LDI R16, 0b11110000 ; = 1 for output =0 for input 
000047 b90a                      OUT DDRD, R16
000048 ef0f                      LDI R16, 0b11111111 ; set with pulls up high.
000049 b90b                      OUT PORTD, R16
                                 
                                 ; shift register setup( PB3/PB4/PB5)
00004a 9a23                      SBI DDRB,3
00004b 9a24                      SBI DDRB,4
00004c 9a25                      SBI DDRB,5
00004d 982b                      CBI PORTB,3
00004e 982c                      CBI PORTB,4
00004f 982d                      CBI PORTB,5
                                 
                                 ; ADC setup: AVCC reference, left adjusted, ADC0 default, prescaler /128
000050 e600                      LDI R16, (1<<REFS0) | (1<<ADLAR) ; AVCC ref+Left adjusted
000051 9300 007c                 STS ADMUX, R16 ; ADC register
000053 2700                      CLR R16
000054 9300 007b                 STS ADCSRB, R16
000056 e003                      LDI R16, (1<<ADC0D) | (1<<ADC1D) ; 
000057 9300 007e                 STS DIDR0, R16
000059 e807                      LDI R16, (1<<ADEN)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0) ; ADEN enable ADC, ADPS2 111 = prescale 128 
00005a 9300 007a                 STS ADCSRA, R16 ; adc clock = 16MHz/128 = 125kHz good adc working frequency 
                                 
                                 ; Timer0 setup - CTC mode, refreshes the display from frame_buffer
00005c e002                      LDI R16, (1<<WGM01)
00005d bd04                      OUT TCCR0A, R16 ; CTC mode
00005e e603                      LDI R16, TIMER0_OCR_VALUE
00005f bd07                      OUT OCR0A, R16 ; comparator register 
000060 e004                      LDI R16, TIMER0_PRESCALE
000061 bd05                      OUT TCCR0B, R16 ; starting timer with prescaler 
000062 e002                      LDI R16, (1<<OCIE0A)
000063 9300 006e                 STS TIMSK0, R16 ;enable timer 0 
                                 
                                 ; Timer1 setup - CTC mode for buzzer pitch.
                                 ; TIMSK1 stays disabled until a note is played.
000065 e000                      LDI R16, 0x00
000066 9300 0080                 STS TCCR1A, R16 ; CTC mode
000068 e00a                      LDI R16, (1<<WGM12) | TIMER1_PRESCALE
000069 9300 0081                 STS TCCR1B, R16 ; timer with prescaler 
00006b e000                      LDI R16, 0x00
00006c 9300 006f                 STS TIMSK1, R16 ; enable timer 1
                                 
                                 ; Timer2 setup - Normal mode, overflow interrupt for input tick and beat tick
00006e e000                      LDI R16, 0x00
00006f 9300 00b0                 STS TCCR2A, R16 ; OV mode 
000071 e004                      LDI R16, (1<<CS22) ; prescaler /64
000072 9300 00b1                 STS TCCR2B, R16
000074 e001                      LDI R16, (1<<TOIE2)
000075 9300 0070                 STS TIMSK2, R16 ; enabling timer 2 
                                 
000077 d08a                      RCALL Reset_All_State
                                 
000078 9478                      SEI ; all interrupt flag enable 
                                 
                                 ;-----------Main loop ------------
                                 main:
                                 
000079 d125                      RCALL Poll_Switch_Mode          ; Read the RUN/EDIT switch and update mode
                                 
                                 ; ---------- Handle user inputs ----------
00007a 9100 019a                 LDS R16, input_tick_flag        ; Has Timer2 requested an input scan
00007c 2300                      TST R16
00007d f069                      BREQ Main_Check_Step_Flag       ; No = skip input handling
                                 
00007e 2700                      CLR R16
00007f 9300 019a                 STS input_tick_flag, R16        ; Clear the input request flag
                                 
000081 d133                      RCALL Read_Keyboard             ; Read keypad
000082 d237                      RCALL Handle_Joystick           ; Read joystick
                                 
                                 ; Only redraw continuously while in EDIT mode
000083 9100 0199                 LDS R16, mode_flags
000085 fd00                      SBRC R16, MODE_RUN_BIT          ; If RUN mode skip the edit refresh
000086 c004                      RJMP Main_Check_Step_Flag       
000087 2d07                      MOV R16, debounce_tick
000088 2300                      TST R16
000089 f409                      BRNE Main_Check_Step_Flag       ; Blink only every half-second
00008a d4a0                      RCALL Render_From_History       ; Refresh display 
                                 ; ---------- Handle sequencer ----------
                                 Main_Check_Step_Flag:
00008b 9100 019b                 LDS R16, step_flag              ; Has Timer2 requested a new step
00008d 2300                      TST R16
00008e f351                      BREQ main                       ; No = return to beginning
00008f 2700                      CLR R16
000090 9300 019b                 STS step_flag, R16              ; Clear the step request
000092 9100 0199                 LDS R16, mode_flags
000094 ff00                      SBRS R16, MODE_RUN_BIT          ; Only step in RUN mode
000095 cfe3                      RJMP main
000096 ff01                      SBRS R16, MODE_PLAY_BIT         ; Ignore if playback is paused
000097 cfe1                      RJMP main
000098 d2f1                      RCALL Advance_Playhead_And_Sound ; Advance playhead and play note
000099 cfdf                      RJMP main                       
                                 
                                 ;====================================
                                 ;INTERRUPT HANDLERS
                                 ;====================================
                                 
                                 ;===========================================
                                 ; TIMER0 ISR - CTC Compare Match A
                                 ; Displays one physical row of frame_buffer.
                                 ; frame_buffer uses 8 physical rows * 10 bytes per row = 80 bytes.
                                 ;===========================================
                                 Timer0_ISR:
00009a 930f                      PUSH R16
00009b b70f                      IN R16, SREG
00009c 930f                      PUSH R16
00009d 931f                      PUSH R17
00009e 932f                      PUSH R18
00009f 933f                      PUSH R19
0000a0 934f                      PUSH R20
0000a1 93ef                      PUSH R30
0000a2 93ff                      PUSH R31
0000a3 920f                      PUSH R0
0000a4 921f                      PUSH R1
                                 
                                 ; Z = frame_buffer + Column_index * 10
0000a5 e02a                      LDI R18, BYTES_PER_PHYSICAL_ROW
0000a6 9e22                      MUL Column_index, R18
0000a7 2de0                      MOV ZL, R0
0000a8 2df1                      MOV ZH, R1
0000a9 2411                      CLR R1
0000aa e308                      LDI R16, LOW(frame_buffer)
0000ab e011                      LDI R17, HIGH(frame_buffer)
0000ac 0fe0                      ADD ZL, R16
0000ad 1ff1                      ADC ZH, R17
                                 
                                 ; Send the 10 column bytes for this physical row.
0000ae e02a                      LDI R18, BYTES_PER_PHYSICAL_ROW
                                 Timer0_Send_Cols:
0000af 9031                      LD display_tempo, Z+
0000b0 2d03                      MOV R16, display_tempo
0000b1 d543                      RCALL SendByte
0000b2 952a                      DEC R18
0000b3 f7d9                      BRNE Timer0_Send_Cols
                                 
                                 ; Send row select byte: row 0 = 0x01, row 1 = 0x02, ...
0000b4 e001                      LDI R16, 0x01
0000b5 2d22                      MOV R18, Column_index
0000b6 2322                      TST R18
0000b7 f019                      BREQ Timer0_RowMask_Ready
                                 Timer0_RowMask_Loop:
0000b8 0f00                      LSL R16
0000b9 952a                      DEC R18
0000ba f7e9                      BRNE Timer0_RowMask_Loop
                                 
                                 Timer0_RowMask_Ready:
0000bb d539                      RCALL SendByte
0000bc d543                      RCALL LatchAndShow
                                 
                                 ; Next physical row, modulo 8
0000bd 9423                      INC Column_index
0000be 2d02                      MOV R16, Column_index
0000bf 3008                      CPI R16, PHYSICAL_ROWS
0000c0 f008                      BRLO Timer0_End
0000c1 2422                      CLR Column_index
                                 
                                 Timer0_End:
0000c2 901f                      POP R1
0000c3 900f                      POP R0
0000c4 91ff                      POP R31
0000c5 91ef                      POP R30
0000c6 914f                      POP R20
0000c7 913f                      POP R19
0000c8 912f                      POP R18
0000c9 911f                      POP R17
0000ca 910f                      POP R16
0000cb bf0f                      OUT SREG, R16
0000cc 910f                      POP R16
0000cd 9518                      RETI
                                 
                                 ;===========================================
                                 ; TIMER1 ISR - CTC Compare Match A
                                 ; Sound interrupt. OCR1A controls frequency, ISR toggles PB1.
                                 ;===========================================
                                 Timer1_ISR:
0000ce 930f                      PUSH R16
0000cf b70f                      IN R16, SREG
0000d0 930f                      PUSH R16
0000d1 9a19                      SBI PINB,1
0000d2 910f                      POP R16
0000d3 bf0f                      OUT SREG,R16
0000d4 910f                      POP R16
0000d5 9518                      RETI
                                 
                                 ;===========================================
                                 ; TIMER2 ISR - Overflow
                                 ; Creates a slow input tick and a sequencer beat tick
                                 ;===========================================
                                 Timer2_ISR:
0000d6 930f                      PUSH R16
0000d7 b70f                      IN R16, SREG
0000d8 930f                      PUSH R16
0000d9 931f                      PUSH R17
                                 
                                 ; input divider: about 10 ms
0000da 9100 019c                 LDS R16, timer2_divider
0000dc 9503                      INC R16
0000dd 300a                      CPI R16, INPUT_TICK_DIV
0000de f090                      BRLO Timer2_Save_Input_Divider
0000df 2700                      CLR R16
0000e0 9300 019a                 STS input_tick_flag, R16
0000e2 e001                      LDI R16, 1
0000e3 9300 019a                 STS input_tick_flag, R16
                                 
                                 ; Blink divider: 25 input ticks = about 250 ms, so the cursor
                                 ; completes one visible on/off cycle in about half a second.
0000e5 9473                      INC debounce_tick
0000e6 2d07                      MOV R16, debounce_tick
0000e7 3109                      CPI R16, 25
0000e8 f038                      BRLO Timer2_Blink_Done
0000e9 2477                      CLR debounce_tick
0000ea 9100 0199                 LDS R16, mode_flags
0000ec e014                      LDI R17, (1<<MODE_BLINK_BIT)
0000ed 2701                      EOR R16, R17 ; toggles bits( with a XOR)
0000ee 9300 0199                 STS mode_flags, R16
                                 
                                 Timer2_Blink_Done:
0000f0 2700                      CLR R16
                                 
                                 Timer2_Save_Input_Divider:
0000f1 9300 019c                 STS timer2_divider, R16
                                 
                                 ; beat divider: about 125 ms
0000f3 9463                      INC beat_counter
0000f4 2d06                      MOV R16, beat_counter
0000f5 9110 019d                 LDS R17, beat_tick_limit
0000f7 1701                      CP R16, R17
0000f8 f020                      BRLO Timer2_End
0000f9 2466                      CLR beat_counter
0000fa e001                      LDI R16, 1
0000fb 9300 019b                 STS step_flag, R16
                                 
                                 Timer2_End:
0000fd 911f                      POP R17
0000fe 910f                      POP R16
0000ff bf0f                      OUT SREG, R16
000100 910f                      POP R16
000101 9518                      RETI
                                 
                                 ;===================================
                                 ; FUNCTIONS
                                 ;===================================
                                 
                                 ;--------------------------------------------------
                                 ; Reset all project state to a clean default.
                                 ;--------------------------------------------------
                                 Reset_All_State:
000102 2422                      CLR Column_index
000103 2433                      CLR display_tempo
000104 2466                      CLR beat_counter
000105 2477                      CLR debounce_tick
000106 2444                      CLR playhead
000107 2455                      CLR cursor
000108 2488                      CLR seed_low
000109 2499                      CLR seed_high
00010a 24aa                      CLR rule_number
00010b 24bb                      CLR scale_index
00010c 24cc                      CLR Octave
                                 
00010d 2700                      CLR R16
00010e 9300 019a                 STS input_tick_flag, R16
000110 9300 019b                 STS step_flag, R16
000112 9300 019c                 STS timer2_divider, R16
000114 9300 019d                 STS beat_tick_limit, R16
000116 9300 019f                 STS prev_js_dir, R16
000118 9300 01a0                 STS prev_js_click, R16
00011a 9300 0191                 STS Cursor_pos, R16
00011c 9300 0197                 STS scale_index_store, R16
00011e 9300 0198                 STS octave_shift, R16
                                 
000120 ef0f                      LDI R16, 0xFF
000121 9300 019e                 STS key_last, R16
                                 
000123 ee01                      LDI R16, DEFAULT_LFSR_LOW
000124 9300 0194                 STS lfsr_seed, R16
000126 2e80                      MOV seed_low, R16
000127 ea0c                      LDI R16, DEFAULT_LFSR_HIGH
000128 9300 0195                 STS lfsr_seed+1, R16
00012a 2e90                      MOV seed_high, R16
                                 
00012b e10e                      LDI R16, DEFAULT_RULE
00012c 9300 0196                 STS rule_number_store, R16
00012e 2ea0                      MOV rule_number, R16
                                 
00012f e003                      LDI R16, (1<<MODE_RUN_BIT) | (1<<MODE_PLAY_BIT)
000130 9300 0199                 STS mode_flags, R16
                                 
000132 e708                      LDI R16, LOW(DEFAULT_BPM)
000133 9300 0192                 STS bpm_value, R16
000135 e000                      LDI R16, HIGH(DEFAULT_BPM)
000136 9300 0193                 STS bpm_value+1, R16
000138 d005                      RCALL Update_Beat_Tick_From_BPM
                                 
000139 d2bf                      RCALL Mute_Buzzer
00013a d3ab                      RCALL Clear_Grid_Data
00013b d3c4                      RCALL Reseed_Current_Gen
00013c d3ee                      RCALL Render_From_History
00013d 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Update the Timer2 software beat limit from bpm_value.
                                 ; bpm_value changes in steps of 10 BPM from 60 to 300.
                                 ; The table values are Timer2 overflow counts, about 1.024 ms each
                                 ; convert BPM value into index to the BPM table.
                                 ;--------------------------------------------------
                                 Update_Beat_Tick_From_BPM:
00013e 930f                      PUSH R16
00013f 931f                      PUSH R17
000140 932f                      PUSH R18
000141 93ef                      PUSH R30
000142 93ff                      PUSH R31
                                 
000143 9100 0192                 LDS R16, bpm_value ;bpm value is 16 bits so R16 high byte R17 low byte 
000145 9110 0193                 LDS R17, bpm_value+1
                                 
                                 ; Clamp BPM 
                                 
000147 2311                      TST R17 ; check if highbyte is 0(if no good, minimum 60 BPM) checking upper limit 
000148 f449                      BRNE BPM_Check_High
000149 330c                      CPI R16, MIN_BPM
00014a f430                      BRSH BPM_Not_Too_Low
00014b e30c                      LDI R16, MIN_BPM ; = 0x003C = 60
00014c 2711                      CLR R17
00014d 9300 0192                 STS bpm_value, R16 ; Clamping BPM min to 60
00014f 9310 0193                 STS bpm_value+1, R17
                                 
                                 BPM_Not_Too_Low:
000151 c00c                      RJMP BPM_Make_Index
                                 
                                 BPM_Check_High:
                                 ; Clamp above 300 BPM. 300 decimal is 0x012C high byte=1(256) low byte = (44)
000152 3011                      CPI R17, 1
000153 f050                      BRLO BPM_Make_Index
000154 f419                      BRNE BPM_Set_300 ;clamping BPM max to 300
000155 320c                      CPI R16, 44
000156 f038                      BRLO BPM_Make_Index
000157 f031                      BREQ BPM_Make_Index
                                 
                                 BPM_Set_300:
000158 e20c                      LDI R16, 44
000159 e011                      LDI R17, 1
00015a 9300 0192                 STS bpm_value, R16
00015c 9310 0193                 STS bpm_value+1, R17
                                 
                                 BPM_Make_Index:
                                 ; index = (bpm - 60) / 10, INdex 0 60 BPM, index 24 300BPM
00015e 530c                      SUBI R16, LOW(MIN_BPM)
00015f 4010                      SBCI R17, HIGH(MIN_BPM)
000160 2722                      CLR R18
                                 
                                 BPM_Index_Loop:
000161 2311                      TST R17
000162 f411                      BRNE BPM_Index_Subtract
000163 300a                      CPI R16, 10
000164 f020                      BRLO BPM_Load_Table
                                 
                                 BPM_Index_Subtract:
000165 500a                      SUBI R16, 10
000166 4010                      SBCI R17, 0
000167 9523                      INC R18
000168 cff8                      RJMP BPM_Index_Loop
                                 
                                 BPM_Load_Table:
000169 e3ee                      LDI ZL, LOW(BPM_Tick_Table*2) ; x2 because word are 2 bytes in Flash 
00016a e0fc                      LDI ZH, HIGH(BPM_Tick_Table*2)
00016b 0fe2                      ADD ZL, R18
00016c 2711                      CLR R17
00016d 1ff1                      ADC ZH, R17
00016e 9104                      LPM R16, Z
00016f 9300 019d                 STS beat_tick_limit, R16
                                 
000171 91ff                      POP R31
000172 91ef                      POP R30
000173 912f                      POP R18
000174 911f                      POP R17
000175 910f                      POP R16
000176 9508                      RET
                                 
                                 Increase_BPM:
000177 930f                      PUSH R16
000178 931f                      PUSH R17
                                 
000179 9100 0192                 LDS R16, bpm_value
00017b 9110 0193                 LDS R17, bpm_value+1
                                 ; if bpm is already 300 (0x012C), stop
00017d 3011                      CPI R17, 1
00017e f411                      BRNE Increase_BPM_Not_Max
00017f 320c                      CPI R16, 44
000180 f438                      BRSH Increase_BPM_End
                                 
                                 Increase_BPM_Not_Max:
000181 5f06                      SUBI R16, LOW(-10)
000182 4f1f                      SBCI R17, HIGH(-10)
000183 9300 0192                 STS bpm_value, R16
000185 9310 0193                 STS bpm_value+1, R17
000187 dfb6                      RCALL Update_Beat_Tick_From_BPM
                                 
                                 Increase_BPM_End:
000188 911f                      POP R17
000189 910f                      POP R16
00018a 9508                      RET
                                 
                                 Decrease_BPM:
00018b 930f                      PUSH R16
00018c 931f                      PUSH R17
                                 
00018d 9100 0192                 LDS R16, bpm_value
00018f 9110 0193                 LDS R17, bpm_value+1
                                 ; if bpm <= 60, stop
000191 2311                      TST R17
000192 f411                      BRNE Decrease_BPM_Do
000193 330d                      CPI R16, MIN_BPM+1
000194 f038                      BRLO Decrease_BPM_End
                                 
                                 Decrease_BPM_Do:
000195 500a                      SUBI R16, LOW(10)
000196 4010                      SBCI R17, HIGH(10)
000197 9300 0192                 STS bpm_value, R16
000199 9310 0193                 STS bpm_value+1, R17
00019b dfa2                      RCALL Update_Beat_Tick_From_BPM
                                 
                                 Decrease_BPM_End:
00019c 911f                      POP R17
00019d 910f                      POP R16
00019e 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Switch PB0 selects RUN or EDIT 
                                 ; HIGH = RUN, LOW = EDIT
                                 ;--------------------------------------------------
                                 Poll_Switch_Mode:
00019f 9100 0199                 LDS R16, mode_flags
0001a1 2f10                      MOV R17, R16
0001a2 9b18                      SBIS PINB, SW_PIN ; skip next inst if bit is set (=1 skip we run),(=0,switch to edit)
0001a3 c002                      RJMP Switch_Edit
                                 
                                 Switch_Run:
0001a4 6001                      ORI R16, (1<<MODE_RUN_BIT) ;set bit 0 so RUN bit become 1 
0001a5 c001                      RJMP Switch_Save
                                 
                                 Switch_Edit:
0001a6 7f0e                      ANDI R16, 0b11111110 ; ANDI clear bit 0 run bit become 0
                                 
                                 Switch_Save:
0001a7 9300 0199                 STS mode_flags, R16
0001a9 2710                      EOR R17, R16 ; detect if mode has changed ( XOR)
0001aa ff10                      SBRS R17, MODE_RUN_BIT ; if didn't change XOR result =0 so RET
0001ab 9508                      RET
0001ac fd00                      SBRC R16, MODE_RUN_BIT ; means RUN MODE(xor=1) SO we skip to rendering 
0001ad c005                      RJMP Switch_Render_Mode
0001ae 6004                      ORI R16, (1<<MODE_BLINK_BIT) ; EDIT Mode, enable cursor blink ( MODE_BLINK_BIT)
0001af 9300 0199                 STS mode_flags, R16
0001b1 2477                      CLR debounce_tick
0001b2 d246                      RCALL Mute_Buzzer
                                 
                                 Switch_Render_Mode:
0001b3 d377                      RCALL Render_From_History
0001b4 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Keyboard scanner.
                                 ; Returns through action routines on a new key press only.
                                 ;PD7 PD6 PD5 PD4   --> Rows (outputs)
                                 
                                 ;PD3 PD2 PD1 PD0   --> Columns (inputs)
                                 ;--------------------------------------------------
                                 Read_Keyboard:
0001b5 d00a                      RCALL Scan_Keypad_Raw
0001b6 9100 019e                 LDS R16, key_last
0001b8 1710                      CP R17, R16
0001b9 f029                      BREQ Read_Keyboard_End
0001ba 9310 019e                 STS key_last, R17
0001bc 3f1f                      CPI R17, 0xFF
0001bd f009                      BREQ Read_Keyboard_End
0001be d070                      RCALL Check_Buttons
                                 
                                 Read_Keyboard_End:
0001bf 9508                      RET
                                 
                                 ; Output: R17 = key value, or 0xFF if no key pressed.
                                 ; Key layout:
                                 ;   7 8 9 F
                                 ;   4 5 6 E
                                 ;   1 2 3 D
                                 ;   A 0 B C
                                 
                                 Scan_Keypad_Raw:
0001c0 ef1f                      LDI R17, 0xFF
0001c1 ef0f                      LDI R16, 0b11111111 ; enable pull up resistors
0001c2 b90b                      OUT PORTD, R16
0001c3 ef00                      LDI R16, 0b11110000 ;row outputs(read),column input
0001c4 b90a                      OUT DDRD, R16
                                 
                                 ;---------------SCAN ROW 1 (7, 8, 9, F)--------------
0001c5 e70f                      LDI R16, 0b01111111 ; row 1 low(=0)
0001c6 b90b                      OUT PORTD, R16
0001c7 0000                      NOP
0001c8 0000                      NOP
0001c9 b139                      IN R19, PIND
0001ca 703f                      ANDI R19, 0b00001111 ; masking because only row output matters(PD3-PD0)
0001cb 303f                      CPI R19, 0b00001111 ; if no key is pressed scan row 2 
0001cc f081                      BREQ Scan_Row_2
0001cd 9b4b                      SBIS PIND, 3 ; skip if bit is set 
0001ce e017                      LDI R17, 7
0001cf 9b4b                      SBIS PIND, 3
0001d0 c059                      RJMP Scan_Keypad_Found
0001d1 9b4a                      SBIS PIND, 2
0001d2 e018                      LDI R17, 8
0001d3 9b4a                      SBIS PIND, 2
0001d4 c055                      RJMP Scan_Keypad_Found
0001d5 9b49                      SBIS PIND, 1
0001d6 e019                      LDI R17, 9
0001d7 9b49                      SBIS PIND, 1
0001d8 c051                      RJMP Scan_Keypad_Found
0001d9 9b48                      SBIS PIND, 0
0001da e01f                      LDI R17, 0x0F
0001db 9b48                      SBIS PIND, 0
0001dc c04d                      RJMP Scan_Keypad_Found
                                 
                                 ;---------------SCAN ROW 2 (4, 5, 6, E)--------------
                                 Scan_Row_2:
0001dd eb0f                      LDI R16, 0b10111111 ; PD6 LOW row 2 
0001de b90b                      OUT PORTD, R16
0001df 0000                      NOP
0001e0 0000                      NOP
0001e1 b139                      IN R19, PIND
0001e2 703f                      ANDI R19, 0b00001111
0001e3 303f                      CPI R19, 0b00001111
0001e4 f081                      BREQ Scan_Row_3
0001e5 9b4b                      SBIS PIND, 3
0001e6 e014                      LDI R17, 4
0001e7 9b4b                      SBIS PIND, 3
0001e8 c041                      RJMP Scan_Keypad_Found
0001e9 9b4a                      SBIS PIND, 2
0001ea e015                      LDI R17, 5
0001eb 9b4a                      SBIS PIND, 2
0001ec c03d                      RJMP Scan_Keypad_Found
0001ed 9b49                      SBIS PIND, 1
0001ee e016                      LDI R17, 6
0001ef 9b49                      SBIS PIND, 1
0001f0 c039                      RJMP Scan_Keypad_Found
0001f1 9b48                      SBIS PIND, 0
0001f2 e01e                      LDI R17, 0x0E
0001f3 9b48                      SBIS PIND, 0
0001f4 c035                      RJMP Scan_Keypad_Found
                                 
                                 ;---------------SCAN ROW 3 (1, 2, 3, D)--------------
                                 Scan_Row_3:
0001f5 ed0f                      LDI R16, 0b11011111 ; PD5 LOW, ROW 3 
0001f6 b90b                      OUT PORTD, R16
0001f7 0000                      NOP
0001f8 0000                      NOP
0001f9 b139                      IN R19, PIND
0001fa 703f                      ANDI R19, 0b00001111
0001fb 303f                      CPI R19, 0b00001111
0001fc f081                      BREQ Scan_Row_4
0001fd 9b4b                      SBIS PIND, 3
0001fe e011                      LDI R17, 1
0001ff 9b4b                      SBIS PIND, 3
000200 c029                      RJMP Scan_Keypad_Found
000201 9b4a                      SBIS PIND, 2
000202 e012                      LDI R17, 2
000203 9b4a                      SBIS PIND, 2
000204 c025                      RJMP Scan_Keypad_Found
000205 9b49                      SBIS PIND, 1
000206 e013                      LDI R17, 3
000207 9b49                      SBIS PIND, 1
000208 c021                      RJMP Scan_Keypad_Found
000209 9b48                      SBIS PIND, 0
00020a e01d                      LDI R17, 0x0D
00020b 9b48                      SBIS PIND, 0
00020c c01d                      RJMP Scan_Keypad_Found
                                 
                                 ;---------------SCAN ROW 4 (A, 0, B, C)--------------
                                 Scan_Row_4:
00020d ee0f                      LDI R16, 0b11101111 ; PD4 LOW, ROW 4
00020e b90b                      OUT PORTD, R16
00020f 0000                      NOP ; needed for signal stabilization
000210 0000                      NOP
000211 b139                      IN R19, PIND
000212 703f                      ANDI R19, 0b00001111
000213 303f                      CPI R19, 0b00001111
000214 f081                      BREQ Scan_Keypad_Idle
000215 9b4b                      SBIS PIND, 3
000216 e01a                      LDI R17, 0x0A
000217 9b4b                      SBIS PIND, 3
000218 c011                      RJMP Scan_Keypad_Found
000219 9b4a                      SBIS PIND, 2
00021a e010                      LDI R17, 0
00021b 9b4a                      SBIS PIND, 2
00021c c00d                      RJMP Scan_Keypad_Found
00021d 9b49                      SBIS PIND, 1
00021e e01b                      LDI R17, 0x0B
00021f 9b49                      SBIS PIND, 1
000220 c009                      RJMP Scan_Keypad_Found
000221 9b48                      SBIS PIND, 0
000222 e01c                      LDI R17, 0x0C
000223 9b48                      SBIS PIND, 0
000224 c005                      RJMP Scan_Keypad_Found
                                 
                                 Scan_Keypad_Idle:
000225 ef0f                      LDI R16, 0b11111111 ;restore everything high
000226 b90b                      OUT PORTD, R16
000227 ef00                      LDI R16, 0b11110000
000228 b90a                      OUT DDRD, R16
000229 9508                      RET
                                 
                                 Scan_Keypad_Found:
00022a ef0f                      LDI R16, 0b11111111
00022b b90b                      OUT PORTD, R16
00022c ef00                      LDI R16, 0b11110000
00022d b90a                      OUT DDRD, R16
00022e 9508                      RET
                                 
                                 Check_Buttons:
                                 
00022f 3017                          CPI R17, 7 ; R17 act as the Action button register 
000230 f409                          BRNE Not7 ; can't use BREQ because action too far --> BRNE+RJMP
000231 c02b                          RJMP Action_Button7
                                 Not7:
                                 
000232 3018                          CPI R17, 8
000233 f409                          BRNE Not8
000234 c02d                          RJMP Action_Button8
                                 Not8:
                                 
000235 3019                          CPI R17, 9
000236 f409                          BRNE Not9
000237 c02f                          RJMP Action_Button9
                                 Not9:
                                 
000238 3014                          CPI R17, 4
000239 f409                          BRNE Not4
00023a c031                          RJMP Action_Button4
                                 Not4:
                                 
00023b 3015                          CPI R17, 5
00023c f409                          BRNE Not5
00023d c033                          RJMP Action_Button5
                                 Not5:
                                 
00023e 3016                          CPI R17, 6
00023f f409                          BRNE Not6
000240 c035                          RJMP Action_Button6
                                 Not6:
                                 
000241 3011                          CPI R17, 1
000242 f409                          BRNE Not1
000243 c037                          RJMP Action_Button1
                                 Not1:
                                 
000244 3012                          CPI R17, 2
000245 f409                          BRNE Not2
000246 c046                          RJMP Action_Button2
                                 Not2:
                                 
000247 301d                          CPI R17, 0x0D
000248 f409                          BRNE NotD
000249 c047                          RJMP Action_ButtonD
                                 NotD:
                                 
00024a 301a                          CPI R17, 0x0A
00024b f409                          BRNE NotA
00024c c046                          RJMP Action_ButtonA
                                 NotA:
                                 
00024d 3010                          CPI R17, 0
00024e f409                          BRNE Not0
00024f c04c                          RJMP Action_button0
                                 Not0:
                                 
000250 301b                          CPI R17, 0x0B
000251 f409                          BRNE NotB
000252 c052                          RJMP Action_buttonB
                                 NotB:
                                 
000253 301c                          CPI R17, 0x0C
000254 f409                          BRNE NotC
000255 c058                          RJMP Action_buttonC
                                 NotC:
                                 
000256 301e                          CPI R17, 0x0E
000257 f409                          BRNE NotE
000258 c05e                          RJMP Action_buttonE
                                 NotE:
                                 
000259 301f                          CPI R17, 0x0F
00025a f409                          BRNE NotF
00025b c05c                          RJMP Action_buttonF
                                 NotF:
                                 
00025c 9508                          RET
                                 
                                 Action_Button7:
                                 ; Rule 30
00025d e10e                      LDI R16, 30
00025e 9300 0196                 STS rule_number_store, R16
000260 2ea0                      MOV rule_number, R16
000261 9508                      RET
                                 
                                 Action_Button8:
                                 ; Rule 90
000262 e50a                      LDI R16, 90
000263 9300 0196                 STS rule_number_store, R16
000265 2ea0                      MOV rule_number, R16
000266 9508                      RET
                                 
                                 Action_Button9:
                                 ; Rule 110
000267 e60e                      LDI R16, 110
000268 9300 0196                 STS rule_number_store, R16
00026a 2ea0                      MOV rule_number, R16
00026b 9508                      RET
                                 
                                 Action_Button4:
                                 ; Major scale
00026c e000                      LDI R16, 0
00026d 9300 0197                 STS scale_index_store, R16
00026f 2eb0                      MOV scale_index, R16
000270 9508                      RET
                                 
                                 Action_Button5:
                                 ; Minor scale
000271 e001                      LDI R16, 1
000272 9300 0197                 STS scale_index_store, R16
000274 2eb0                      MOV scale_index, R16
000275 9508                      RET
                                 
                                 Action_Button6:
                                 ; Pentatonic scale
000276 e002                      LDI R16, 2
000277 9300 0197                 STS scale_index_store, R16
000279 2eb0                      MOV scale_index, R16
00027a 9508                      RET
                                 
                                 Action_Button1:
                                 ; Reseed current generation with the LFSR.
00027b 9100 0194                 LDS R16, lfsr_seed
00027d 9110 0195                 LDS R17, lfsr_seed+1 ; loading current 16 bit LFSR
00027f b526                      IN R18, TCNT0 ; read value of timer 0 
000280 2702                      EOR R16, R18 ; XOR the LFSR seed with the timing for randomness
000281 e22a                      LDI R18, 0x2A
000282 2712                      EOR R17, R18 ; also modify the high byte ( 16 bit LFSR)
000283 9300 0194                 STS lfsr_seed, R16
000285 9310 0195                 STS lfsr_seed+1, R17 ; store new seed
000287 2e80                      MOV seed_low, R16
000288 2e91                      MOV seed_high, R17
000289 d25c                      RCALL Clear_Grid_Data ; erase everything 
00028a d275                      RCALL Reseed_Current_Gen
00028b d29f                      RCALL Render_From_History
00028c 9508                      RET
                                 
                                 Action_Button2:
                                 ; Clear grid
00028d d16b                      RCALL Mute_Buzzer
00028e d257                      RCALL Clear_Grid_Data
00028f d29b                      RCALL Render_From_History
000290 9508                      RET
                                 
                                 Action_ButtonD:
                                 ; Reset
000291 de70                      RCALL Reset_All_State
000292 9508                      RET
                                 
                                 Action_ButtonA:
                                 ; Octave down
000293 9100 0198                 LDS R16, octave_shift
000295 2300                      TST R16
000296 f021                      BREQ Action_ButtonA_End
000297 950a                      DEC R16
000298 9300 0198                 STS octave_shift, R16
00029a 2ec0                      MOV Octave, R16
                                 Action_ButtonA_End:
00029b 9508                      RET
                                 
                                 Action_button0:
                                 ; Octave up. Limited to 1 so the 32-step scale stays inside Note_Table.
00029c 9100 0198                 LDS R16, octave_shift
00029e 3001                      CPI R16, 1
00029f f420                      BRSH Action_button0_End
0002a0 9503                      INC R16
0002a1 9300 0198                 STS octave_shift, R16
0002a3 2ec0                      MOV Octave, R16
                                 Action_button0_End:
0002a4 9508                      RET
                                 
                                 Action_buttonB:
                                 ; Toggle play/pause.
0002a5 9100 0199                 LDS R16, mode_flags
0002a7 e022                      LDI R18, (1<<MODE_PLAY_BIT)
0002a8 2702                      EOR R16, R18
0002a9 9300 0199                 STS mode_flags, R16
0002ab ff01                      SBRS R16, MODE_PLAY_BIT
0002ac d14c                      RCALL Mute_Buzzer
0002ad 9508                      RET
                                 
                                 Action_buttonC:
                                     ; Toggle Global Mute (Bit 3) on/off
0002ae 9100 0199                     LDS  R16, mode_flags
0002b0 e028                          LDI  R18, (1<<MODE_MUTE_BIT)
0002b1 2702                          EOR  R16, R18               ; Flip the mute bit
0002b2 9300 0199                     STS  mode_flags, R16
                                     
                                     ; If we just turned mute ON (Bit 3 is now 1), kill the hanging sound immediately
0002b4 fd03                          SBRC R16, MODE_MUTE_BIT     
0002b5 d143                          RCALL Mute_Buzzer
0002b6 9508                          RET
                                 
                                 Action_buttonE:
0002b7 9508                      RET
                                 
                                 Action_buttonF:
0002b8 9508                      RET
                                 
                                 Action_All_OFF:
0002b9 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Joystick handling.
                                 ; RUN mode:
                                 ;   left/right = BPM down/up
                                 ;   up/down    = octave up/down
                                 ;   click      = play/pause
                                 ; EDIT mode:
                                 ;   left/right = move cursor on row 0
                                 ;   click      = toggle current cell, so that bit plays later in RUN
                                 ;--------------------------------------------------
                                 Handle_Joystick:
0002ba d051                      RCALL Handle_Joystick_Click
                                 
0002bb e020                      LDI R18, 0
0002bc d068                      RCALL Read_ADC
0002bd 3c30                      CPI R19, ADC_HIGH_TH ; high threshold of ADC
0002be f4d0                      BRSH Joy_Right
0002bf 3430                      CPI R19, ADC_LOW_TH ; LOW threshold of ADC 
0002c0 f050                      BRLO Joy_Left
                                 
0002c1 e021                      LDI R18, 1
0002c2 d062                      RCALL Read_ADC
0002c3 3c30                      CPI R19, ADC_HIGH_TH
0002c4 f568                      BRSH Joy_Down
0002c5 3430                      CPI R19, ADC_LOW_TH
0002c6 f100                      BRLO Joy_Up
                                 
                                 Joy_Center:
0002c7 2700                      CLR R16
0002c8 9300 019f                 STS prev_js_dir, R16
0002ca 9508                      RET
                                 
                                 Joy_Left:
0002cb e001                      LDI R16, DIR_LEFT
0002cc d031                      RCALL Joystick_Direction_Edge
0002cd 2300                      TST R16
0002ce f171                      BREQ Handle_Joystick_End
0002cf 9120 0199                 LDS R18, mode_flags
0002d1 fd20                      SBRC R18, MODE_RUN_BIT
0002d2 c003                      RJMP Joy_Left_Run
0002d3 d070                      RCALL Cursor_Left
0002d4 d256                      RCALL Render_From_History
0002d5 9508                      RET
                                 
                                 Joy_Left_Run:
0002d6 deb4                      RCALL Decrease_BPM
0002d7 d253                      RCALL Render_From_History
0002d8 9508                      RET
                                 
                                 Joy_Right:
0002d9 e002                      LDI R16, DIR_RIGHT
0002da d023                      RCALL Joystick_Direction_Edge
0002db 2300                      TST R16
0002dc f101                      BREQ Handle_Joystick_End
0002dd 9120 0199                 LDS R18, mode_flags
0002df fd20                      SBRC R18, MODE_RUN_BIT
0002e0 c003                      RJMP Joy_Right_Run
0002e1 d068                      RCALL Cursor_Right
0002e2 d248                      RCALL Render_From_History
0002e3 9508                      RET
                                 
                                 Joy_Right_Run:
0002e4 de92                      RCALL Increase_BPM
0002e5 d245                      RCALL Render_From_History
0002e6 9508                      RET
                                 
                                 Joy_Up:
0002e7 e004                      LDI R16, DIR_UP
0002e8 d015                      RCALL Joystick_Direction_Edge
0002e9 2300                      TST R16
0002ea f091                      BREQ Handle_Joystick_End
0002eb 9120 0199                 LDS R18, mode_flags
0002ed fd20                      SBRC R18, MODE_RUN_BIT
0002ee c001                      RJMP Joy_Up_Run
0002ef 9508                      RET
                                 
                                 Joy_Up_Run:
0002f0 dfab                      RCALL Action_button0
0002f1 9508                      RET
                                 
                                 Joy_Down:
0002f2 e008                      LDI R16, DIR_DOWN
0002f3 d00a                      RCALL Joystick_Direction_Edge
0002f4 2300                      TST R16
0002f5 f039                      BREQ Handle_Joystick_End
0002f6 9120 0199                 LDS R18, mode_flags
0002f8 fd20                      SBRC R18, MODE_RUN_BIT
0002f9 c001                      RJMP Joy_Down_Run
0002fa 9508                      RET
                                 
                                 Joy_Down_Run:
0002fb df97                      RCALL Action_ButtonA
0002fc 9508                      RET
                                 
                                 Handle_Joystick_End:
0002fd 9508                      RET
                                 
                                 Joystick_Direction_Edge:
                                 ; Input R16 = direction code. Output R16 = 1 if new direction, 0 if held.
0002fe 931f                      PUSH R17
0002ff 2f10                      MOV R17, R16
000300 9100 019f                 LDS R16, prev_js_dir
000302 1701                      CP R16, R17
000303 f029                      BREQ Joy_Direction_Held
000304 9310 019f                 STS prev_js_dir, R17
000306 e001                      LDI R16, 1
000307 911f                      POP R17
000308 9508                      RET
                                 
                                 Joy_Direction_Held:
000309 2700                      CLR R16
00030a 911f                      POP R17
00030b 9508                      RET
                                 
                                 Handle_Joystick_Click:
                                 ; PB2 LOW means pressed.
00030c 2711                      CLR R17
00030d 9b1a                      SBIS PINB, JS_BTN_PIN
00030e e011                      LDI R17, 1
00030f 9100 01a0                 LDS R16, prev_js_click
000311 1710                      CP R17, R16
000312 f089                      BREQ Handle_Joystick_Click_End
000313 9310 01a0                 STS prev_js_click, R17
000315 2311                      TST R17
000316 f069                      BREQ Handle_Joystick_Click_End
                                 
000317 9100 0199                 LDS R16, mode_flags
000319 fd00                      SBRC R16, MODE_RUN_BIT
00031a c003                      RJMP Handle_Joystick_Click_Run
                                 
00031b d036                      RCALL Toggle_Cursor_Cell
00031c d20e                      RCALL Render_From_History
00031d c006                      RJMP Handle_Joystick_Click_End
                                 
                                 Handle_Joystick_Click_Run:
00031e e022                      LDI R18, (1<<MODE_PLAY_BIT)
00031f 2702                      EOR R16, R18
000320 9300 0199                 STS mode_flags, R16
000322 ff01                      SBRS R16, MODE_PLAY_BIT
000323 d0d5                      RCALL Mute_Buzzer
                                 
                                 Handle_Joystick_Click_End:
000324 9508                      RET
                                 
                                 ; ADC READER SUBROUTINE
                                 ;only lower 4 bit of ADMUX select chanel 
                                 ;we use left adjust because we only need 8 bit ( Joystick still 124, up 256 down 0)
                                 ; Input: R18 (Channel 0-15)
                                 ; Output: R19 (8-bit ADC result)
                                 Read_ADC:
000325 930f                      PUSH R16
000326 932f                      PUSH R18
000327 702f                      ANDI R18, 0x0F
000328 6620                      ORI R18, (1<<REFS0) | (1<<ADLAR) ; AVVC Reference ( 5V) and left adjust for 8 bit instead of 10 bit
000329 9320 007c                 STS ADMUX, R18 ; Ouput in R18 
00032b 0000                      NOP ; small delay after channel change 
00032c 0000                      NOP
                                 
00032d 9100 007a                 LDS R16, ADCSRA
00032f 6400                      ORI R16, (1<<ADSC) ; set ADSC for starting conversion( Analog to digital)
000330 9300 007a                 STS ADCSRA, R16
                                 
                                 Wait_For_ADC:
000332 9100 007a                 LDS R16, ADCSRA ; read ADC status
000334 fd06                      SBRC R16, ADSC ; ADSC=1 while it's running then it turn to 0
000335 cffc                      RJMP Wait_For_ADC
                                 
000336 9130 0079                 LDS R19, ADCH ; read the 8 MSB of the conversion results 
000338 912f                      POP R18
000339 910f                      POP R16
00033a 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Cursor helpers.
                                 ; EDIT mode uses one 32-bit melody row. Cursor_pos stores x only.
                                 ; y is always 0, so toggled cells are immediately playable in RUN.
                                 ;--------------------------------------------------
                                 ;history buffer each row is 4 bytes
                                 
                                 Get_Cursor_X:
00033b 9140 0191                 LDS R20, Cursor_pos
00033d 9508                      RET
                                 
                                 Set_Cursor_X:
00033e 9340 0191                 STS Cursor_pos, R20
000340 9508                      RET
                                 
                                 Get_Cursor_Y:
000341 2755                      CLR R21
000342 9508                      RET
                                 
                                 Set_Cursor_Y:
000343 9508                      RET
                                 
                                 Cursor_Left:
000344 dff6                      RCALL Get_Cursor_X
000345 2344                      TST R20
000346 f011                      BREQ Cursor_Left_End
000347 954a                      DEC R20
000348 dff5                      RCALL Set_Cursor_X
                                 Cursor_Left_End:
000349 9508                      RET
                                 
                                 Cursor_Right:
00034a dff0                      RCALL Get_Cursor_X
00034b 314f                      CPI R20, CA_WIDTH-1
00034c f410                      BRSH Cursor_Right_End
00034d 9543                      INC R20
00034e dfef                      RCALL Set_Cursor_X
                                 Cursor_Right_End:
00034f 9508                      RET
                                 
                                 Cursor_Up:
000350 9508                      RET
                                 
                                 Cursor_Down:
000351 9508                      RET
                                 
                                 Toggle_Cursor_Cell:
000352 931f                      PUSH R17
000353 932f                      PUSH R18
000354 933f                      PUSH R19
000355 934f                      PUSH R20
000356 935f                      PUSH R21
000357 93ef                      PUSH R30
000358 93ff                      PUSH R31
                                 
000359 dfe1                      RCALL Get_Cursor_X
00035a 2f14                      MOV R17, R20
00035b dfe5                      RCALL Get_Cursor_Y
00035c 2f25                      MOV R18, R21
00035d d00e                      RCALL Get_History_Address
00035e 8140                      LD R20, Z
00035f 2743                      EOR R20, R19
000360 8340                      ST Z, R20
                                 
000361 2322                      TST R18
000362 f409                      BRNE Toggle_Cursor_Cell_End
000363 d153                      RCALL Copy_History_Top_To_Current
                                 
                                 Toggle_Cursor_Cell_End:
000364 91ff                      POP R31
000365 91ef                      POP R30
000366 915f                      POP R21
000367 914f                      POP R20
000368 913f                      POP R19
000369 912f                      POP R18
00036a 911f                      POP R17
00036b 9508                      RET
                                 
                                 ; Input: R17 = x 0..31, R18 = y 0..13 y= nb of row skipped ( each row has 4 bytes=32 columns) ex y=2 2*4=8 bytes skip)
                                 ; inside that row we divide by 8 example x=13/8 = Byte 1 total offset = y*4+x/8
                                 ;Byte0 = bits 0..7
                                 ;Byte1 = bits 8..15
                                 ;Byte2 = bits 16..23
                                 ;Byte3 = bits 24..31
                                 ; Output: Z = history_buffer + y*4 + x/8, R19 = bit mask 1<<(x&7)
                                 
                                 Get_History_Address:
00036c 930f                      PUSH R16
00036d 931f                      PUSH R17
00036e 932f                      PUSH R18
00036f 934f                      PUSH R20
                                 
000370 2f02                      MOV R16, R18
000371 0f00                      LSL R16
000372 0f00                      LSL R16
000373 2f41                      MOV R20, R17
000374 9546                      LSR R20
000375 9546                      LSR R20
000376 9546                      LSR R20
000377 0f04                      ADD R16, R20
                                 
000378 e0e0                      LDI ZL, LOW(history_buffer)
000379 e0f1                      LDI ZH, HIGH(history_buffer)
00037a 0fe0                      ADD ZL, R16
00037b 2744                      CLR R20
00037c 1ff4                      ADC ZH, R20
                                 
00037d 2f41                      MOV R20, R17
00037e 7047                      ANDI R20, 0x07 ; only the lowest 3 bit remain ( 0x07=00000111) useful modulo 8.
00037f e031                      LDI R19, 1
                                 History_Mask_Loop:
000380 2344                      TST R20
000381 f019                      BREQ History_Mask_Done
000382 0f33                      LSL R19
000383 954a                      DEC R20
000384 cffb                      RJMP History_Mask_Loop
                                 
                                 History_Mask_Done:
000385 914f                      POP R20
000386 912f                      POP R18
000387 911f                      POP R17
000388 910f                      POP R16
000389 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Sequencer step and sound.
                                 ; One active bit at the current playhead position plays a note.
                                 ; One inactive bit is silence.
                                 ; Pitch increases from low to high as playhead goes 0..31.
                                 ;--------------------------------------------------
                                 Advance_Playhead_And_Sound:
00038a d1a0                      RCALL Render_From_History
00038b d011                      RCALL Play_Playhead_Note
                                 
00038c 9100 0190                 LDS R16, playhead_pos
00038e 9503                      INC R16
00038f 3200                      CPI R16, CA_WIDTH
000390 f040                      BRLO Advance_Save_Playhead
                                 
000391 2700                      CLR R16
000392 9300 0190                 STS playhead_pos, R16
000394 2e40                      MOV playhead, R16
000395 d06a                      RCALL Apply_Rule
000396 d136                      RCALL Shift_Waterfall
000397 d193                      RCALL Render_From_History
000398 9508                      RET
                                 
                                 Advance_Save_Playhead:
000399 9300 0190                 STS playhead_pos, R16
00039b 2e40                      MOV playhead, R16
00039c 9508                      RET
                                 
                                 Play_Playhead_Note:
00039d 931f                      PUSH R17
00039e 932f                      PUSH R18
00039f 933f                      PUSH R19
0003a0 934f                      PUSH R20
0003a1 93ef                      PUSH R30
0003a2 93ff                      PUSH R31
                                 
0003a3 9100 0199                 LDS R16, mode_flags
0003a5 ff01                      SBRS R16, MODE_PLAY_BIT
0003a6 c023                      RJMP Play_Playhead_Mute
                                 
0003a7 fd03                      SBRC R16, MODE_MUTE_BIT    ; If MUTE bit is 1, skip playing the note!
0003a8 c021                      RJMP Play_Playhead_Mute
                                 
0003a9 9120 0190                 LDS R18, playhead_pos
0003ab d088                      RCALL Get_Current_Bit
0003ac 2333                      TST R19
0003ad f0e1                      BREQ Play_Playhead_Mute
                                 
                                 ; Select the scale table.
0003ae 9100 0197                 LDS R16, scale_index_store
0003b0 3001                      CPI R16, 1
0003b1 f029                      BREQ Play_Use_Minor
0003b2 3002                      CPI R16, 2
0003b3 f031                      BREQ Play_Use_Penta
                                 
                                 Play_Use_Major:
0003b4 ece8                      LDI ZL, LOW(Major_Scale_32*2) ; (*2 because word are 16 bits)
0003b5 e0fc                      LDI ZH, HIGH(Major_Scale_32*2)
0003b6 c005                      RJMP Play_Get_Index
                                 
                                 Play_Use_Minor:
0003b7 eee8                      LDI ZL, LOW(Minor_Scale_32*2)
0003b8 e0fc                      LDI ZH, HIGH(Minor_Scale_32*2)
0003b9 c002                      RJMP Play_Get_Index
                                 
                                 Play_Use_Penta:
0003ba e0e8                      LDI ZL, LOW(Pentatonic_Scale_32*2)
0003bb e0fd                      LDI ZH, HIGH(Pentatonic_Scale_32*2)
                                 
                                 Play_Get_Index:
0003bc 9110 0190                 LDS R17, playhead_pos
0003be 0fe1                      ADD ZL, R17
0003bf 2722                      CLR R18
0003c0 1ff2                      ADC ZH, R18
0003c1 9114                      LPM R17, Z
                                 
                                 ; Add octave shift: 0 or 12 semitones.
0003c2 9120 0198                 LDS R18, octave_shift
0003c4 e03c                      LDI R19, 12
0003c5 9f23                      MUL R18, R19
0003c6 0d10                      ADD R17, R0
0003c7 2411                      CLR R1
                                 
0003c8 d009                      RCALL Play_Note_Index
0003c9 c001                      RJMP Play_Playhead_End
                                 
                                 Play_Playhead_Mute:
0003ca d02e                      RCALL Mute_Buzzer
                                 
                                 Play_Playhead_End:
0003cb 91ff                      POP R31
0003cc 91ef                      POP R30
0003cd 914f                      POP R20
0003ce 913f                      POP R19
0003cf 912f                      POP R18
0003d0 911f                      POP R17
0003d1 9508                      RET
                                 
                                 ; Input: R17 = note index in Note_Table, or out of range for mute.
                                 Play_Note_Index:
0003d2 930f                      PUSH R16
0003d3 932f                      PUSH R18
0003d4 933f                      PUSH R19
0003d5 934f                      PUSH R20
0003d6 93ef                      PUSH R30
0003d7 93ff                      PUSH R31
                                 
0003d8 3310                      CPI R17, NB_NOTES ;R17 contain NOTE INDEX ( 0 first note 10 eleventh note)
0003d9 f4b8                      BRSH Play_Note_Mute
                                 
0003da 2f21                      MOV R18, R17 ; copy the note index
0003db 2733                      CLR R19
0003dc 0f22                      LSL R18
0003dd 1f33                      ROL R19 ; multiply note index by 2 because Note_table is 16 bit(2 bytes)( shift left with ROL)
                                 
0003de e6e8                      LDI ZL, LOW(Note_Table*2)
0003df e0fc                      LDI ZH, HIGH(Note_Table*2)
0003e0 0fe2                      ADD ZL, R18
0003e1 1ff3                      ADC ZH, R19
                                 
0003e2 9125                      LPM R18, Z+
0003e3 9134                      LPM R19, Z
                                 
                                 ; Write 16-bit OCR1A high byte first. OCR1A is 16 bit output compare register of T1
0003e4 9330 0089                 STS OCR1AH, R19
0003e6 9320 0088                 STS OCR1AL, R18
                                 
                                 ; Reset timer phase for cleaner attacks on each note.
0003e8 2700                      CLR R16
0003e9 9300 0085                 STS TCNT1H, R16 ; configure timer 1 for notes 
0003eb 9300 0084                 STS TCNT1L, R16
                                 
0003ed e002                      LDI R16, (1<<OCIE1A)
0003ee 9300 006f                 STS TIMSK1, R16 ; enable timer interrupt again play everytime TCNT1==OCR1A
0003f0 c001                      RJMP Play_Note_End
                                 
                                 Play_Note_Mute:
0003f1 d007                      RCALL Mute_Buzzer
                                 
                                 Play_Note_End:
0003f2 91ff                      POP R31
0003f3 91ef                      POP R30
0003f4 914f                      POP R20
0003f5 913f                      POP R19
0003f6 912f                      POP R18
0003f7 910f                      POP R16
0003f8 9508                      RET
                                 
                                 Mute_Buzzer:
0003f9 930f                      PUSH R16
0003fa 2700                      CLR R16
0003fb 9300 006f                 STS TIMSK1, R16 ;disable timer 1 interrupt 
0003fd 9829                      CBI PORTB, BUZZER_PIN ; force buzzer pin low 
0003fe 910f                      POP R16
0003ff 9508                      RET
                                 
                                 ;--------------------------------------------------
                                 ; Cellular automaton.
                                 ; current_gen and next_gen are 32 bits each.
                                 ; Rule number is read from rule_number_store.
                                 ;rule : For each cell (0..31):
                                    ; Read left neighbour
                                   ;  Read current cell
                                    ; Read right neighbour
                                    ; Form a 3-bit number
                                   ;  Look up the corresponding output bit in the rule number( R30, R90, R110)
                                   ;  Store the result in next_gen
                                 ;When finished:
                                  ;   Copy next_gen into current_gen
                                 
                                 ;--------------------------------------------------
                                 Apply_Rule:
000400 932f                      PUSH R18
000401 933f                      PUSH R19
000402 934f                      PUSH R20
000403 935f                      PUSH R21
000404 936f                      PUSH R22
000405 937f                      PUSH R23
                                 
000406 d074                      RCALL Clear_Next_Gen
000407 2744                      CLR R20
                                 
                                 Apply_Rule_Loop:
                                 ; read left neighbour
000408 2f24                      MOV R18, R20 ; R20 goes from 0 to 31
000409 2322                      TST R18
00040a f411                      BRNE Apply_Left_No_Wrap ; automaton is circular if x=0 we read left=31
00040b e12f                      LDI R18, CA_WIDTH-1
00040c c001                      RJMP Apply_Left_Read
                                 
                                 Apply_Left_No_Wrap:
00040d 952a                      DEC R18
                                 
                                 Apply_Left_Read:
00040e d025                      RCALL Get_Current_Bit ; reads current_gen(left) and return R19 =0 or 1
00040f 0f33                      LSL R19
000410 0f33                      LSL R19 ; multiply by 4 because left neighbour is the MSB  of the 3 bit neighbour 
000411 2f53                      MOV R21, R19
                                 
                                 ; read the center bit 
000412 2f24                      MOV R18, R20
000413 d020                      RCALL Get_Current_Bit
000414 0f33                      LSL R19
000415 2b53                      OR R21, R19
                                 
                                 ; read right neighbour bit 
000416 2f24                      MOV R18, R20
000417 9523                      INC R18
000418 3220                      CPI R18, CA_WIDTH
000419 f008                      BRLO Apply_Right_Read
00041a 2722                      CLR R18
                                 
                                 Apply_Right_Read:
00041b d018                      RCALL Get_Current_Bit
00041c 2b53                      OR R21, R19 ; example left=1 center=0 right=1 R21=101=5 ( base 2)
                                 
                                 ; output = (rule >> neighbourhood) & 1
00041d 9160 0196                 LDS R22, rule_number_store ; rule 30, 90 or 110 
00041f 2f75                      MOV R23, R21
                                 Apply_Rule_Shift:
000420 2377                      TST R23
000421 f019                      BREQ Apply_Rule_Shift_Done
000422 9566                      LSR R22
000423 957a                      DEC R23
000424 cffb                      RJMP Apply_Rule_Shift
                                 
                                 Apply_Rule_Shift_Done:
000425 7061                      ANDI R22, 1 ; keeps only bit 0 after shifting the value of the next cells 
000426 2f24                      MOV R18, R20
000427 2f36                      MOV R19, R22
000428 d02f                      RCALL Set_Next_Bit
                                 
000429 9543                      INC R20
00042a 3240                      CPI R20, CA_WIDTH
00042b f2e0                      BRLO Apply_Rule_Loop
                                 
00042c d05e                      RCALL Copy_Next_To_Current
                                 
00042d 917f                      POP R23
00042e 916f                      POP R22
00042f 915f                      POP R21
000430 914f                      POP R20
000431 913f                      POP R19
000432 912f                      POP R18
000433 9508                      RET
                                 
                                 ; Input: R18 = bit index 0..31. Output: R19 = 0 or 1.
                                 Get_Current_Bit:
000434 930f                      PUSH R16
000435 932f                      PUSH R18
000436 934f                      PUSH R20
000437 935f                      PUSH R21
000438 93ef                      PUSH R30
000439 93ff                      PUSH R31
                                 
00043a 2f42                      MOV R20, R18
00043b 9546                      LSR R20
00043c 9546                      LSR R20
00043d 9546                      LSR R20
                                 
00043e e8e8                      LDI ZL, LOW(current_gen)
00043f e0f1                      LDI ZH, HIGH(current_gen)
000440 0fe4                      ADD ZL, R20
000441 2700                      CLR R16
000442 1ff0                      ADC ZH, R16
000443 8150                      LD R21, Z
                                 
000444 2f42                      MOV R20, R18
000445 7047                      ANDI R20, 0x07
000446 e031                      LDI R19, 1
                                 Current_Mask_Loop:
000447 2344                      TST R20
000448 f019                      BREQ Current_Mask_Done
000449 0f33                      LSL R19
00044a 954a                      DEC R20
00044b cffb                      RJMP Current_Mask_Loop
                                 
                                 Current_Mask_Done:
00044c 2353                      AND R21, R19
00044d f011                      BREQ Current_Bit_Zero
00044e e031                      LDI R19, 1
00044f c001                      RJMP Current_Bit_End
                                 
                                 Current_Bit_Zero:
000450 2733                      CLR R19
                                 
                                 Current_Bit_End:
000451 91ff                      POP R31
000452 91ef                      POP R30
000453 915f                      POP R21
000454 914f                      POP R20
000455 912f                      POP R18
000456 910f                      POP R16
000457 9508                      RET
                                 
                                 ; Input: R18 = bit index 0..31, R19 = 0/1.
                                 Set_Next_Bit:
000458 2333                      TST R19
000459 f101                      BREQ Set_Next_Bit_End
                                 
00045a 930f                      PUSH R16
00045b 932f                      PUSH R18
00045c 934f                      PUSH R20
00045d 935f                      PUSH R21
00045e 93ef                      PUSH R30
00045f 93ff                      PUSH R31
                                 
000460 2f42                      MOV R20, R18
000461 9546                      LSR R20
000462 9546                      LSR R20
000463 9546                      LSR R20
                                 
000464 e8ec                      LDI ZL, LOW(next_gen)
000465 e0f1                      LDI ZH, HIGH(next_gen)
000466 0fe4                      ADD ZL, R20
000467 2700                      CLR R16
000468 1ff0                      ADC ZH, R16
                                 
000469 2f42                      MOV R20, R18
00046a 7047                      ANDI R20, 0x07
00046b e051                      LDI R21, 1
                                 Next_Mask_Loop:
00046c 2344                      TST R20
00046d f019                      BREQ Next_Mask_Done
00046e 0f55                      LSL R21
00046f 954a                      DEC R20
000470 cffb                      RJMP Next_Mask_Loop
                                 
                                 Next_Mask_Done:
000471 8100                      LD R16, Z
000472 2b05                      OR R16, R21
000473 8300                      ST Z, R16
                                 
000474 91ff                      POP R31
000475 91ef                      POP R30
000476 915f                      POP R21
000477 914f                      POP R20
000478 912f                      POP R18
000479 910f                      POP R16
                                 
                                 Set_Next_Bit_End:
00047a 9508                      RET
                                 
                                 Clear_Next_Gen:
00047b 930f                      PUSH R16
00047c 932f                      PUSH R18
00047d 93ef                      PUSH R30
00047e 93ff                      PUSH R31
                                 
00047f e8ec                      LDI ZL, LOW(next_gen)
000480 e0f1                      LDI ZH, HIGH(next_gen)
000481 e024                      LDI R18, 4
000482 2700                      CLR R16
                                 Clear_Next_Loop:
000483 9301                      ST Z+, R16
000484 952a                      DEC R18
000485 f7e9                      BRNE Clear_Next_Loop
                                 
000486 91ff                      POP R31
000487 91ef                      POP R30
000488 912f                      POP R18
000489 910f                      POP R16
00048a 9508                      RET
                                 
                                 Copy_Next_To_Current:
00048b 930f                      PUSH R16
00048c 932f                      PUSH R18
00048d 93cf                      PUSH R28
00048e 93df                      PUSH R29
00048f 93ef                      PUSH R30
000490 93ff                      PUSH R31
                                 
000491 e8ec                      LDI ZL, LOW(next_gen)
000492 e0f1                      LDI ZH, HIGH(next_gen)
000493 e8c8                      LDI YL, LOW(current_gen)
000494 e0d1                      LDI YH, HIGH(current_gen)
000495 e024                      LDI R18, 4
                                 Copy_Next_Loop:
000496 9101                      LD R16, Z+
000497 9309                      ST Y+, R16
000498 952a                      DEC R18
000499 f7e1                      BRNE Copy_Next_Loop
                                 
00049a 91ff                      POP R31
00049b 91ef                      POP R30
00049c 91df                      POP R29
00049d 91cf                      POP R28
00049e 912f                      POP R18
00049f 910f                      POP R16
0004a0 9508                      RET
                                 
                                 Copy_Current_To_History_Top:
0004a1 930f                      PUSH R16
0004a2 932f                      PUSH R18
0004a3 93cf                      PUSH R28
0004a4 93df                      PUSH R29
0004a5 93ef                      PUSH R30
0004a6 93ff                      PUSH R31
                                 
0004a7 e8e8                      LDI ZL, LOW(current_gen)
0004a8 e0f1                      LDI ZH, HIGH(current_gen)
0004a9 e0c0                      LDI YL, LOW(history_buffer)
0004aa e0d1                      LDI YH, HIGH(history_buffer)
0004ab e024                      LDI R18, 4
                                 Copy_Current_Top_Loop:
0004ac 9101                      LD R16, Z+
0004ad 9309                      ST Y+, R16
0004ae 952a                      DEC R18
0004af f7e1                      BRNE Copy_Current_Top_Loop
                                 
0004b0 91ff                      POP R31
0004b1 91ef                      POP R30
0004b2 91df                      POP R29
0004b3 91cf                      POP R28
0004b4 912f                      POP R18
0004b5 910f                      POP R16
0004b6 9508                      RET
                                 
                                 Copy_History_Top_To_Current:
0004b7 930f                      PUSH R16
0004b8 932f                      PUSH R18
0004b9 93cf                      PUSH R28
0004ba 93df                      PUSH R29
0004bb 93ef                      PUSH R30
0004bc 93ff                      PUSH R31
                                 
0004bd e0e0                      LDI ZL, LOW(history_buffer)
0004be e0f1                      LDI ZH, HIGH(history_buffer)
0004bf e8c8                      LDI YL, LOW(current_gen)
0004c0 e0d1                      LDI YH, HIGH(current_gen)
0004c1 e024                      LDI R18, 4
                                 Copy_History_Top_Loop:
0004c2 9101                      LD R16, Z+
0004c3 9309                      ST Y+, R16
0004c4 952a                      DEC R18
