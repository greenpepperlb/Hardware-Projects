                                 ; 16-bit Galois LFSR, polynomial 0xB400.
                                 ; Output: R18 low byte, R19 high byte.
                                 LFSR16_Step:
000512 930f                      PUSH R16
000513 934f                      PUSH R20
000514 935f                      PUSH R21
                                 
000515 9120 0194                 LDS R18, lfsr_seed
000517 9130 0195                 LDS R19, lfsr_seed+1
000519 2f42                      MOV R20, R18
00051a 7041                      ANDI R20, 1
                                 
00051b 9536                      LSR R19
00051c 9527                      ROR R18
                                 
00051d 2344                      TST R20
00051e f011                      BREQ LFSR_No_Xor
00051f eb54                      LDI R21, 0xB4
000520 2735                      EOR R19, R21
                                 
                                 LFSR_No_Xor:
000521 9320 0194                 STS lfsr_seed, R18
000523 9330 0195                 STS lfsr_seed+1, R19
000525 2e82                      MOV seed_low, R18
000526 2e93                      MOV seed_high, R19
                                 
000527 915f                      POP R21
000528 914f                      POP R20
000529 910f                      POP R16
00052a 9508                      RET
                                 
