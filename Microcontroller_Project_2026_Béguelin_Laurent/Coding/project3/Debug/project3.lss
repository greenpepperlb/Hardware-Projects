                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; project3.asm
                                 ;
                                 ; Created: 27-02-26 15:25:19
                                 ; Author : laurent
                                 
                                 ; Include ATmega328P definitions
                                 .include "m328pdef.inc" 
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .ORG 0x0000
000000 c033                      	rjmp initialisation  ; jump to start
                                 
                                 ; Interrupt adress Vectors
                                 .ORG 0x0016 ;Timer 1 OV
000016 c10b                      	rjmp Timer1_ISR
                                 
                                 .ORG 0x0020 ; timer 0 OV
000020 c0f7                      	rjmp Timer0_ISR
                                 
                                 ;-----------------------END OF INTERRUPT VECTORS-------------------------
                                 .ORG 0x0034
                                 initialisation:
                                 ; --- Initialize Stack Pointer ---
000034 ef0f                          LDI R16, LOW(RAMEND)
000035 bf0d                          OUT SPL, R16
000036 e008                          LDI R16, HIGH(RAMEND)
000037 bf0e                          OUT SPH, R16
                                 
                                 ; --- Setup of pins ---
                                 ; joystick
000038 9822                      CBI DDRB,2 ;pin PB2 as input
000039 9a2a                      SBI PORTB,2 ; pin PB2 has pull up resistor
                                 ;LED 1
00003a 9a3b                      SBI DDRC,3 ; pin PC3 as output
00003b 9a43                      SBI PORTC,3 ; pin PC3 is set high
                                 ;LED 2
00003c 9a3a                      SBI DDRC,2 ; pin PC2 as output
00003d 9a42                      SBI PORTC,2 ; pin PC2 is set high
                                 
                                 ;Switch
00003e 9820                      CBI DDRB,0 ; set pin PB0 as input
00003f 9a28                      SBI PORTB,0 ; enable pull up resistor
                                 ;Buzzer
000040 9a21                      SBI DDRB,1
                                 ;Keyboard setup
000041 ef00                      LDI R16, 0b11110000 ; Output PD7-PD4, input PD3 PD0 
000042 b90a                      OUT DDRD, R16 ; ROWS= Output Columns = input
000043 ef0f                      LDI R16, 0b11111111 ; Setting up the pull up resistors 
000044 b90b                      OUT PORTD, R16
                                 ;Shift register setup
000045 9a23                      SBI DDRB,3 ;Set PB3 as output
000046 9a24                      SBI DDRB,4 ;Set PB4 as output
000047 9a25                      SBI DDRB,5 ;Set PB5 as output
                                 
000048 982b                      CBI PORTB,3   ; DATA = 0
000049 982c                      CBI PORTB,4   ; LATCH = 0
00004a 982d                      CBI PORTB,5   ; CLOCK = 0
                                 ;Timers 0 setup
00004b e000                      LDI R16,0x00
00004c bd04                      OUT TCCR0A, R16 ; Normal mode 
                                 
00004d eb09                      LDI R16, 185
00004e bd06                      OUT TCNT0, R16 ; LOad value of the timer
                                 
00004f e004                      LDI R16,(1<< CS02)
000050 bd05                      OUT TCCR0B, R16 ; prescaler 
                                 
                                 ;Timer 1 setup CTC Mode 
000051 e000                      LDI R16, 0x00
000052 9300 0080                 STS TCCR1A, R16 ; Manual interrupt pin toggle
                                 
000054 e00a                      LDI R16, (1<<WGM12)|(1<<CS11) ; bit 3 and bit 1 of TCCR1B
000055 9300 0081                 STS TCCR1B, R16
000057 e000                      LDI R16, 0x00
000058 9300 006f                 STS TIMSK1,R16 ; enable CTC interrupt 
                                 ;initial frequency 
                                 ;LDI R16, HIGH(2272)
                                 ;STS OCR1AH,R16
                                 ;LDI R16, LOW(2272)
                                 ;STS OCR1AL,R16
                                 
                                 ;Empty register
00005a 2411                      CLR R1
                                 
00005b 9478                      SEI ; enable global interrupt 
                                 
                                 ;-----loop----------
                                 main :
                                 	;RCALL Task1
                                 	;RCALL Task2
                                 	;RCALL Task3
                                 	;RCALL Task4
                                 	;RCALL Task5
                                 	;RCALL Task6
                                 	;RCALL Task7
                                 	;RCALL Task8
                                 	;RCALL Task9
00005c d0a6                      	RCALL Task10
00005d cffe                      	RJMP main ; repeat
                                 
                                 Task1: 
                                 ;led on when button is pressed
00005e b003                      	in R0,PINB ; get value of pinB in R0
00005f fa02                      	BST R0,2 ; copy PB2 to the Tflag
000060 f416                      	BRTC Joypressed
                                 
                                 JoyNotPressed:
000061 9a43                      	SBI PORTC,3 ; turn off led2
000062 9508                      	RET
                                 JoyPressed :
000063 9843                      	CBI PORTC,3 ; turn on led2
000064 9508                      	RET ; infinite loop
000065 9508                      RET 
                                 Task2 :
                                 ;led on when switch is high
000066 b013                      	IN R1,PINB
000067 fa10                      	BST R1,0
000068 f016                      	BRTS SwitchHigh
                                 SwitchLow:
000069 9a43                      SBI PORTC,3
00006a 9508                      RET
                                 SwitchHigh:
00006b 9843                      CBI PORTC,3
00006c 9508                      RET
                                 Task3:
                                 ;blink the led
00006d 9843                          CBI PORTC,3   ; LED ON (active low)
00006e d003                          RCALL Delay
00006f 9a43                          SBI PORTC,3   ; LED OFF
000070 d001                          RCALL Delay
000071 9508                          RET 
                                 
                                 ; -------- DELAY ROUTINE ----------
                                 Delay:
000072 e644                          LDI R20, 100     
                                 ; outermost loop
                                 OuterLoop:
000073 ec28                          LDI R18, 200     
                                 ; middle loop
                                 MiddleLoop:
000074 ef3f                          LDI R19, 255     
                                 ; inner loop
                                 InnerLoop:
000075 953a                          DEC R19
000076 f7f1                          BRNE InnerLoop
000077 952a                          DEC R18
000078 f7d9                          BRNE MiddleLoop
000079 954a                          DEC R20
00007a f7c1                          BRNE OuterLoop
00007b 9508                          RET
                                 
                                 Task4: 
                                 	;Make the buzzer sound audibly.
00007c 9a19                      	SBI PINB,1
00007d d001                      	RCALL delay_audio
00007e 9508                      	RET
                                 	delay_audio :
00007f e158                      	LDI R21,24
                                 	audio_outer :
000080 ef6f                      	LDI R22,255
                                 	audio_inner :
000081 956a                      	DEC R22
000082 f7f1                      	BRNE audio_inner
000083 955a                      	DEC R21
000084 f7d9                      	BRNE audio_outer
000085 9508                      	RET
                                 
                                 Task5:
000086 b003                      	in R0,PINB ; get value of pinB in R0
000087 fa02                      	BST R0,2 ; copy PB2 to the Tflag
000088 f42e                      	BRTC ButtonPressed
                                 	ButtonNotPressed:
000089 e010                      		LDI R17, 0x00
00008a 9310 006e                 		STS TIMSK0, R17
00008c 9829                      		CBI PORTB, 1
00008d 9508                      		RET
                                 	ButtonPressed :
00008e e011                      		LDI R17, (1<<TOIE0)
00008f 9310 006e                 		STS TIMSK0, R17
000091 9508                      		RET 
                                 	; Make the buzzer sound at 440Hz when the button of the joystick is pressed. Use a timer and an interrupt to achieve this. 
                                 
                                 Task6:
                                 	;Make the buzzer sound at 440Hz and 880Hz based on the state of the switch. Use a timer and an interrupt to achieve this.
                                 
000092 b013                      	IN R1,PINB
000093 fa10                      	BST R1,0
000094 f03e                      	BRTS SwitchHigh2
                                 	SwitchLow2: ;440
000095 e008                      		LDI R16, high(2272)
000096 9300 0089                 		STS OCR1AH, R16
000098 ee00                      		LDI R16,low(2272)
000099 9300 0088                 		STS OCR1AL, R16
00009b 9508                      		RET
                                 
                                 	SwitchHigh2: ;880
00009c e004                      		LDI R16, high(1135)
00009d 9300 0089                 		STS OCR1AH, R16
00009f e60f                      		LDI R16,low(1135)
0000a0 9300 0088                 		STS OCR1AL, R16
0000a2 9508                      		RET
                                 	 
                                 Task7: 
                                 
                                 	;Implement one method to readout the keyboard, write code such that the buttons do the following: 
                                 	;Button 7: Two leds on; Button 8: Bottom led on; Button 4: Top Led on; All other buttons: Buzzer on; 
                                 	;No buttons pressed: Leds and buzzer off
0000a3 e020                      	LDI R18, 0 ;Was a button pressed flag 
                                 
                                 	;---------------SCAN  ROW 1 ( 7, 8, 9, F)--------------
                                 
0000a4 e70f                      	LDI R16, 0b01111111 ; set PD7 LOW so row1 active 
0000a5 b90b                      	OUT PORTD, R16
0000a6 0000                      	NOP
0000a7 b119                      	IN R17,PIND
0000a8 2f31                      	MOV R19, R17
0000a9 703f                      	ANDI R19,0b00001111
0000aa 303f                      	CPI R19, 0b00001111
0000ab f019                      	BREQ Scan_Row_2
0000ac e061                      	LDI R22, 1
0000ad e021                      	LDI R18, 1
0000ae c07c                      	RJMP Check_Buttons
                                 
                                 	;---------------SCAN  ROW 2 ( 4, 5, 6, E)--------------
                                 	Scan_Row_2 :
0000af eb0f                      	LDI R16, 0b10111111 ; set PD6 LOW so row2 active 
0000b0 b90b                      	OUT PORTD, R16
0000b1 0000                      	NOP
0000b2 b119                      	IN R17,PIND
0000b3 2f31                      	MOV R19, R17
0000b4 703f                      	ANDI R19,0b00001111
0000b5 303f                      	CPI R19, 0b00001111
0000b6 f019                      	BREQ Scan_Row_3
0000b7 e062                      	LDI R22, 2
0000b8 e021                      	LDI R18, 1
0000b9 c071                      	RJMP Check_Buttons
                                 
                                 	;---------------SCAN  ROW 3 ( 1, 2, 3, D)--------------
                                 	Scan_Row_3 :
0000ba ed0f                      	LDI R16, 0b11011111 ; set PD5 LOW so row3 active 
0000bb b90b                      	OUT PORTD, R16
0000bc 0000                      	NOP
0000bd b119                      	IN R17,PIND
0000be 2f31                      	MOV R19, R17
0000bf 703f                      	ANDI R19,0b00001111
0000c0 303f                      	CPI R19, 0b00001111
0000c1 f019                      	BREQ Scan_Row_4
0000c2 e063                      	LDI R22, 3
0000c3 e021                      	LDI R18, 1
0000c4 c066                      	RJMP Check_Buttons
                                 
                                 	;---------------SCAN  ROW 4 ( A, 0, B, C)--------------
                                 	Scan_Row_4 :
0000c5 ee0f                      	LDI R16, 0b11101111 ; set PD4 LOW so row4 active 
0000c6 b90b                      	OUT PORTD, R16
0000c7 0000                      	NOP
0000c8 b119                      	IN R17,PIND
0000c9 2f31                      	MOV R19, R17
0000ca 703f                      	ANDI R19,0b00001111
0000cb 303f                      	CPI R19, 0b00001111
0000cc f019                      	BREQ Final_Check
0000cd e064                      	LDI R22, 4
0000ce e021                      	LDI R18, 1
0000cf c05b                      	RJMP Check_Buttons 
                                 	;--------Final check-----------
                                 	Final_Check :
0000d0 3020                      	CPI R18, 0 
0000d1 f409                      	BRNE Skip_All_OFF
0000d2 c084                      	RJMP Action_All_OFF
                                 	Skip_All_OFF :
0000d3 9508                      	RET
                                 
                                 Task8:
                                 	;Get something on the screen. Shift out something into the shift registers of the screen
                                 	; such that at least one LED is on. 
                                 	
0000d4 e002                      	LDI R16,0x02
0000d5 d088                      	RCALL SendByte ;column byte 1
0000d6 e000                      	LDI R16, 0x00
0000d7 d086                      	RCALL SendByte ; column byte 2 
0000d8 e000                      	LDI R16,0x00
0000d9 d084                      	RCALL SendByte ;column byte 3
0000da e000                      	LDI R16, 0x00
0000db d082                      	RCALL SendByte ; column byte 4
0000dc e003                      	LDI R16,0x03
0000dd d080                      	RCALL SendByte ;column byte 5
0000de e000                      	LDI R16, 0x00
0000df d07e                      	RCALL SendByte ; column byte 6
0000e0 e000                      	LDI R16,0x00
0000e1 d07c                      	RCALL SendByte ;column byte 7
0000e2 e000                      	LDI R16, 0x00
0000e3 d07a                      	RCALL SendByte ; column byte 8
0000e4 e000                      	LDI R16,0x00
0000e5 d078                      	RCALL SendByte ;column byte 9
0000e6 e000                      	LDI R16, 0x00
0000e7 d076                      	RCALL SendByte ; column byte 10
0000e8 e001                      	LDI R16, 0x01
0000e9 d074                      	RCALL SendByte ; Rows bytes
0000ea d07e                      	RCALL LatchAndShow
0000eb 9508                      	RET
                                 	 
                                 Task9: 
                                 	;Make a checkerboard pattern on the screen. Alternating leds on-of-on-off.
0000ec e050                      	LDI R21, 0
0000ed e061                      	LDI R22, 0x01 ; bitmask used for rows select
                                 Right_Pattern : 
0000ee 2355                      	TST R21 ; testing the Zero flag for odd/even patter
0000ef f419                      	BRNE Use_odd
0000f0 e0f2                      	LDI ZH, high(EvenPattern<<1)
0000f1 eee6                      	LDI ZL,low(EvenPattern<<1)
0000f2 c002                      	RJMP SendCols
                                 Use_odd :
0000f3 e0f2                      	LDI ZH, high(OddPattern<<1)
0000f4 efe0                      	LDI ZL,low(OddPattern<<1)
                                 SendCols : 
0000f5 e02a                      	LDI R18, 10 ; 10bytes = 80 columns
                                 Col_Loop : 
0000f6 9105                      	LPM R16, Z+
0000f7 d066                      	RCALL SendByte
0000f8 952a                      	DEC R18
0000f9 f7e1                      	BRNE Col_Loop
                                 	;------Sending the rows---------
                                 
0000fa 2f06                      	MOV R16,R22      ; copy current row mask
0000fb d062                      	RCALL SendByte   ; SendByte destroys R16, not R22
                                 
0000fc d06c                      	RCALL LatchAndShow
                                 	; Alternate checkerboard pattern
0000fd 9550                      	COM R21
0000fe 7051                      	ANDI R21,1
                                 
                                 	; Advance to next row
0000ff 0f66                      	LSL R22
000100 f769                      	BRNE Right_Pattern
                                 
                                 	; Finished all rows, start again
000101 e061                      	LDI R22,0x01
000102 9508                      	RET	
                                 
                                 Task10:
                                     ; Display character 'A'
                                 
                                     ; Z -> beginning of character A
000103 e0f2                          LDI ZH, HIGH(CharTable<<1)
000104 efea                          LDI ZL, LOW(CharTable<<1)
                                 
                                     ; First active row
000105 e061                          LDI R22, 0x01
                                 
                                     ; 8 rows
000106 e028                          LDI R18, 8
                                 
                                 RowLoop:
                                 	; turn off all rows
000107 e000                           LDI R16,0x00
000108 d055                           RCALL SendByte
                                     ;-------------------------------------------------
                                     ; Send the first 9 column bytes as blank
                                     ;-------------------------------------------------
000109 e049                          LDI R20,9
                                 
                                 BlankLoop:
00010a e000                          LDI R16,0x00
00010b d052                          RCALL SendByte
00010c 954a                          DEC R20
00010d f7e1                          BRNE BlankLoop
                                 
                                     ;-------------------------------------------------
                                     ; Send one row of the character
                                     ;-------------------------------------------------
00010e 9105                          LPM R16,Z+
00010f d04e                          RCALL SendByte
                                 
                                     ;-------------------------------------------------
                                     ; Send row select byte
                                     ;-------------------------------------------------
000110 2f06                          MOV R16,R22
000111 d04c                          RCALL SendByte
000112 d056                          RCALL LatchAndShow
                                 
000113 d05b                      	RCALL SmallDelay
                                     ; Next row
000114 0f66                          LSL R22
                                 
000115 952a                          DEC R18
000116 f781                          BRNE RowLoop
                                 
000117 9508                          RET
                                 ;------------------------------------------------SUBROUTINES---------------------------
                                 Timer0_ISR :
                                 	;Prologue : save states
000118 930f                      	PUSH R16
000119 b70f                      	IN R16, SREG
00011a 930f                      	PUSH R16
00011b eb09                      	LDI R16, 185
00011c bd06                      	OUT TCNT0, R16
00011d 9a19                      	SBI PINB,1
00011e 910f                      	POP R16
00011f bf0f                      	OUT SREG,R16
000120 910f                      	POP R16
000121 9518                      	RETI
                                 
                                 Timer1_ISR :
                                 	;Prologue : save states
000122 930f                      	PUSH R16
000123 b70f                      	IN R16, SREG
000124 930f                      	PUSH R16
000125 9a19                      	SBI PINB,1
000126 910f                      	POP R16
000127 bf0f                      	OUT SREG,R16
000128 910f                      	POP R16
000129 9518                      	RETI
                                 ;------------------------------FUNCTIONS-----------------------------------------------------------------
                                 MyFunction1 :
                                 	;function space
00012a 9508                      	RET
                                 Check_Buttons :
00012b 3061                      	CPI R22, 1
00012c f019                      	BREQ Check_Row1_Buttons
00012d 3062                      	CPI R22, 2
00012e f031                      	BREQ Check_Row2_Buttons
00012f c01b                      	RJMP Action_buzzer
                                 
                                 
                                 Check_Row1_Buttons :
000130 9b4b                      	SBIS PIND, 3
000131 c006                      	RJMP Action_button7
000132 9b4a                      	SBIS PIND, 2
000133 c00b                      	RJMP Action_button8
000134 c016                      	RJMP Action_buzzer
                                 Check_Row2_Buttons :
000135 9b4b                      	SBIS PIND, 3
000136 c00e                      	RJMP Action_button4
000137 c013                      	RJMP Action_buzzer
                                 	
                                 
                                 
                                 
                                 Action_button7 :
000138 9842                      	CBI PORTC,2 ; turn on Top LED
000139 9843                      	CBI PORTC,3 ; turn on Bot LED
00013a e010                      	LDI R17, 0x00
00013b 9310 006f                 	STS TIMSK1, R17
00013d 9829                      	CBI PORTB, 1
00013e 9508                      	RET
                                 
                                 Action_button8 :
00013f 9843                      	CBI PORTC, 3 ; turn on Bot LED
000140 e010                      	LDI R17, 0x00
000141 9310 006f                 	STS TIMSK1, R17
000143 9829                      	CBI PORTB, 1
000144 9508                      	RET
                                 
                                 Action_button4 :
000145 9842                      	CBI PORTC, 2 ; turn on Top LED
000146 e010                      	LDI R17, 0x00
000147 9310 006f                 	STS TIMSK1, R17
000149 9829                      	CBI PORTB, 1
00014a 9508                      	RET
                                 
                                 Action_buzzer : 
00014b 9a43                      	SBI PORTC, 3 ;turn off Bot LED 
00014c 9a42                      	SBI PORTC, 2 ;turn off Top LED 
                                 	;Adjust pitch 
00014d e008                      	LDI R16, high(2272)
00014e 9300 0089                 	STS OCR1AH, R16
000150 ee00                      	LDI R16,low(2272)
000151 9300 0088                 	STS OCR1AL, R16
                                 	;Turn the buzzer on 
000153 e012                      	LDI R17, (1<<OCIE1A)
000154 9310 006f                 	STS TIMSK1, R17
000156 9508                      	RET
                                 
                                 Action_All_OFF :
000157 9a43                      	SBI PORTC, 3 ;turn off Bot LED 
000158 9a42                      	SBI PORTC, 2 ;turn off Top LED 
000159 e010                      	LDI R17, 0x00
00015a 9310 006f                 	STS TIMSK1, R17
00015c 9829                      	CBI PORTB, 1
00015d 9508                      	RET
                                 
                                 ;Sends the 8 bits in R16 out MSB-First.Destroy R16 R17
                                 SendByte : 
00015e e018                      	LDI R17, 8
00015f 9488                      	CLC
                                 SendByte_loop : 
000160 982b                      	CBI PORTB,3 ;clearing data-in
000161 0f00                      	LSL R16     ; MSB-->Carry
000162 f408                      	BRCC SendByte_skip ; branch if carry is 0
000163 9a2b                      	SBI PORTB,3 ; carry was 1
                                 SendByte_skip : 
000164 982d                      	CBI PORTB,5
000165 9a2d                      	SBI PORTB,5 ; rising edge to load the shift register 
000166 951a                      	DEC R17
000167 f7c1                      	BRNE SendByte_loop
000168 9508                      	RET
                                 ;Latches and show
