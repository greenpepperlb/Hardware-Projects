classdef Network < matlab.mixin.Copyable
    %NETWORK Summary of this class goes here
    %   Detailed explanation goes here
    
    properties (Access = private)
        num_nodes,
        cons,
        mergers
    end
    
    methods
        function obj = Network()
            %NETWORK Construct an empty network
            obj.num_nodes = 0;
            obj.cons = sym([]);
            obj.mergers = cell(0);
        end

        function V = solve(obj, I, I_port_nums)
            Yn = obj.cons(I_port_nums, :);
            Yn = Yn(:, I_port_nums);
            V = Yn \ I;
        end
        
        function node_idx = new_node(obj)
            %new_node Registers a new node
            obj.num_nodes = obj.num_nodes + 1;
            node_idx = obj.num_nodes;
            obj.mergers(node_idx) = cell(1);
        end

        function varargout = new_nodes(obj)
            n = nargout;
            base = obj.num_nodes + 1;
            last_node = obj.num_nodes + n;
            varargout = num2cell(base:last_node);
            obj.num_nodes = obj.num_nodes + n;
            obj.mergers(last_node) = cell(1);
        end


        function out = new_node_list(obj, n)
            base = obj.num_nodes + 1;
            last_node = obj.num_nodes + n;
            out = base:last_node;
            obj.num_nodes = obj.num_nodes + n;
            obj.mergers(last_node) = cell(1);
        end

        function canon = merge_nodes(obj, n1, n2)
            n1 = obj.canon_node(n1);
            n2 = obj.canon_node(n2);
            if n1 == n2
                canon = n1;
                return;
            end

            if n2 > 0
                obj.mergers(n2) = {n1};
                canon = n1;
            else
                obj.mergers(n1) = {0};
                canon = 0;
            end
        end

        function node = canon_node(obj, node)
            while node > 0 && ~isempty(obj.mergers{node})
                node = obj.mergers{node};
            end
        end

        function connect_Z(obj, n1, n2, Z)
            n1 = obj.canon_node(n1);
            n2 = obj.canon_node(n2);
            if Z == 0
                obj.merge_nodes(n1, n2);
            else
                obj.connect_Y(n1, n2, 1/Z)
            end
        end

        function connect_Y(obj, n1, n2, Y)
            n1 = obj.canon_node(n1);
            n2 = obj.canon_node(n2);
            if isinf(Y)
                obj.merge_nodes(n1, n2);
            else
                max_idx = max(n1, n2);
                if max_idx > length(obj.cons)
                    obj.cons(max_idx, max_idx) = 0;
                end
                if n1 > 0
                    obj.cons(n1, n1) = obj.cons(n1, n1) + Y;
                end
                if n2 > 0
                    obj.cons(n2, n2) = obj.cons(n2, n2) + Y;
                end
                if n1 > 0 && n2 > 0
                    obj.cons(n1, n2) = obj.cons(n1, n2) - Y;
                    obj.cons(n2, n1) = obj.cons(n1, n2);
                end
            end
        end

        function connect_mosfet(obj, mos, s, g, d, b, jw)
            s = obj.canon_node(s);
            g = obj.canon_node(g);
            d = obj.canon_node(d);
            b = obj.canon_node(b);

            obj.vccs(d, s, g, s, mos.gm);
            %obj.connect_Y(s, d, mos.gds);
            % obj.connect_Y(g, b, jw*mos.cgb);
            % obj.connect_Y(g, d, jw*mos.cgd);
            obj.connect_Y(g, s, jw*mos.cgs);
            % obj.connect_Y(s, b, jw*mos.csb);
            % obj.connect_Y(d, b, jw*mos.cdb);
        end

        function vccs(obj, src, dst, vref1, vref2, gm)
            src = obj.canon_node(src);
            dst = obj.canon_node(dst);
            vref1 = obj.canon_node(vref1);
            vref2 = obj.canon_node(vref2);

            max_idx = max([src, dst, vref1, vref2]);
            if max_idx > length(obj.cons)
                obj.cons(max_idx, max_idx) = 0;
            end

            if src > 0 && vref1 > 0
                obj.cons(src, vref1) = obj.cons(src, vref1)+gm;
            end
            if src > 0 && vref2 > 0
                obj.cons(src, vref2) = obj.cons(src, vref2)-gm;
            end
            if dst > 0 && vref1 > 0
                obj.cons(dst, vref1) = obj.cons(dst, vref1)-gm;
            end
            if dst > 0 && vref2 > 0
                obj.cons(dst, vref2) = obj.cons(dst, vref2)+gm;
            end
        end

        function connect_Ymat(obj, Y, ports)
            max_idx = max(ports);
            if max_idx > length(obj.cons)
                obj.cons(max_idx, max_idx) = 0;
            end
            n = length(ports);
            for i = 1:n
                ports(i) = obj.canon_node(ports(i));
            end
            for r = 1:n
                if ports(r) == 0
                    continue;
                end
                for c = 1:n
                    if ports(c) == 0
                        continue;
                    end
                    obj.cons(ports(r), ports(c)) = obj.cons(ports(r), ports(c)) + Y(r, c);
                end
            end
        end

        function Yn = nodal_admittance_matrix(obj)
            Yn = obj.cons;
        end

        function [Y, Vmap] = Y_params(obj, ports)
            Yn = obj.nodal_admittance_matrix();
            internal_nodes = 1:obj.num_nodes;
            internal_nodes(ports) = [];
            Yn = [Yn(ports, :); Yn(internal_nodes, :)];
            Yn = [Yn(:, ports) Yn(:, internal_nodes)];

            n = length(ports);
            A = simplify(null(Yn((1+n):end, :)));

            % for i = 1:n
            %     if A(i, i) ~= 0
            %         A(:, i) = A(:, i) / A(i, i);
            %     end
            %     for j = 1:n
            %         if i == j
            %             continue;
            %         end
            %         A(:, j) = simplify(A(:, j) - A(:, i) * A(i, j));
            %     end
            % end
            A = A / A(1:n, 1:n);

            Vmap = simplify(A);
            Y = Yn * Vmap;
            Y = simplify(Y(1:n, 1:n));
            Vmap([ports(:); internal_nodes(:)], :) = Vmap;
        end
    end
end

